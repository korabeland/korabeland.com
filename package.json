{
  "name": "personal-site",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "predev": "pnpm gen:trail-register && pnpm gen:hero-variants && pnpm gen:eye-rig && pnpm gen:corpus-index",
    "dev": "astro dev",
    "prebuild": "pnpm gen:trail-register && pnpm gen:shift-log && pnpm gen:hero-variants && pnpm gen:eye-rig && pnpm gen:corpus-index",
    "build": "astro build",
    "postbuild": "tsx scripts/patch-vercel-config.ts && tsx scripts/check-built-site.ts && tsx scripts/smoke-production-build.ts",
    "preview": "astro preview",
    "sync": "astro sync",
    "gen:trail-register": "tsx scripts/gen-trail-register.ts",
    "gen:shift-log": "tsx scripts/gen-shift-log.ts",
    "gen:hero-variants": "tsx scripts/gen-hero-variants.ts",
    "gen:eye-rig": "tsx scripts/gen-eye-rig.ts",
    "gen:corpus-index": "tsx scripts/gen-corpus-index.ts",
    "export:pageviews": "tsx scripts/export-pageviews.ts",
    "verify": "pnpm gen:corpus-index && biome check . && astro sync && tsc --noEmit && astro check",
    "pretest": "pnpm gen:eye-rig",
    "test": "vitest run",
    "test:visual": "playwright test",
    "reseed:visual": "node scripts/reseed-visual.mjs",
    "smoke:production": "tsx scripts/smoke-production-build.ts",
    "lighthouse": "pnpm build && lhci autorun && lhci autorun --config=.lighthouserc.mobile.json",
    "verify:all": "pnpm verify && pnpm test && pnpm test:visual && pnpm run lighthouse && pnpm smoke:production"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-ch52-4w7c-c8xp"
      ]
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "postcss": "^8.5.24",
      "brace-expansion": "^5.0.11",
      "minimatch": "^10.2.6",
      "sharp": "^0.35.4",
      "svgo": "^4.1.0",
      "js-yaml@^4": "^4.3.2",
      "nanoid@^3": "^3.3.18",
      "nanoid@^5": "^5.1.16",
      "tar@^7": "^7.5.21",
      "ws@^8": "^8.21.0",
      "devalue@^5": "^5.9.3",
      "source-map-js": "^1.2.2",
      "prosemirror-view": "^1.42.3",
      "@vercel/routing-utils>path-to-regexp": "6.3.0",
      "storybook>esbuild": "0.28.1",
      "tmp@<0.2.6": "^0.2.6",
      "uuid@^8": "^11.1.1",
      "zod@^4": "^4.6.6",
      "undici@^8": "^8.12.2"
    }
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/react": "^7.1.0",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.16",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.5.50",
    "@markdoc/markdoc": "^0.5.10",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "astro": "^7.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satori": "^0.26.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.5.15",
    "@chromatic-com/playwright": "^0.13.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chromatic": "^16.3.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
