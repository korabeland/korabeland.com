# Node
node_modules/
.npm
npm-debug.log*
.pnpm-debug.log*

# Astro
dist/
.astro/

# Environment
.env
.env.local
.env.*.local

# Agent state (budget tracker, session state)
.agent-state/

# Build output
.vercel/

# Lighthouse CI reports
.lighthouseci/

# Test artifacts
playwright-report/
test-results/
chromatic-*.json

# PR-preview screenshots — generated per-branch by /open-pr and attached to the
# PR, never committed (they deploy world-readable from public/ otherwise).
public/pr-previews/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Visual test diffs (baselines are committed, diffs are ephemeral)
tests/visual/diffs/

# Generated PR description (local, used by /open-pr command)
.pr-description.md

# Trail-register: generated per-build by scripts/gen-trail-register.ts.
# Seed (commits.seed.json) is committed as the shallow-clone fallback.
src/content/trail-register/commits.json

# Shift-log: generated per-build by scripts/gen-shift-log.ts.
# Seed (contributions.seed.json) is committed as the fallback.
src/content/shift-log/contributions.json
.vercel
.env*.local

# Stray local build log (accidentally committed via git add -A in 136e7ae)
build-archive.log

# Git worktrees checked out under the main repo (each has its own tree/branch;
# committed here only via the worktree's own git dir, never the main checkout).
.claude/worktrees/

# Hero image variants: generated per-build/dev by scripts/gen-hero-variants.ts
# from the originals Keystatic stores. Never committed — regenerated on demand.
public/**/*.gen.*
.gstack/

# Portrait gaze v2 measurement scratch (U2): throwaway centroid/retouch/proof
# scripts and their PNG outputs. Not shipped — the SSOT is src/lib/portrait-gaze.ts.
.gaze-measure/
