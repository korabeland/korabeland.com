---
// /work — case-study index. Copy + the work slice of the projects
// collection; ProjectLedger renders the shared ledger grammar. See
// docs/plans/2026-07-03-console-mvp.md.

import ProjectLedger from "../../components/ProjectLedger/ProjectLedger.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { listProjects } from "../../lib/projects";

const projects = (await listProjects()).filter((p) => p.category === "work");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": "https://korabeland.com/work",
  url: "https://korabeland.com/work",
  name: "work · case studies · korabeland.com",
  description:
    "Case studies from the field: evidence, decisions, and outcomes across marketing, CX and AI operations.",
  isPartOf: { "@id": "https://korabeland.com/#website" },
};
---

<BaseLayout
  title="work · case studies · korab eland"
  description="Case studies from the field: evidence, decisions, and outcomes across marketing, CX and AI operations."
  active="work"
>
  <script type="application/ld+json" slot="jsonld" set:html={JSON.stringify(jsonLd)} />

  <ProjectLedger
    eyebrow="work · case studies"
    intro="The evidence behind the outcomes. Each entry is a real project, with the decisions and the numbers that came out of it."
    heading="all case studies"
    emptyText="first case studies being written up."
    projects={projects}
  />
</BaseLayout>
