---
// /work — case-study index. Renders the shared ProjectLedger (also used by
// the homepage outcome ledger and the /lab index): title / mono outcome
// datum / status chip. Work-category slice only; /lab renders the side
// projects through the same component. See docs/plans/2026-07-03-console-mvp.md.

import ProjectLedger from "../../components/ProjectLedger/index.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { listProjects, projectHref, projectStatus } from "../../lib/projects";

const projects = (await listProjects()).filter((p) => p.category === "work");
const ledgerItems = projects.map((p) => ({
  slug: p.slug,
  title: p.title,
  outcome: p.outcome,
  status: projectStatus(p),
  href: projectHref(p),
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": "https://korabeland.com/work",
  url: "https://korabeland.com/work",
  name: "work · case studies · korabeland.com",
  description:
    "Case studies from the field: evidence, decisions, and outcomes across marketing, CX and AI operations.",
  isPartOf: { "@id": "https://korabeland.com/#website" },
};
---

<BaseLayout
  title="work · case studies · korab eland"
  description="Case studies from the field: evidence, decisions, and outcomes across marketing, CX and AI operations."
  active="work"
>
  <script type="application/ld+json" slot="jsonld" set:html={JSON.stringify(jsonLd)} />

  <div class="work">
    <section class="work-head">
      <p class="t-label work-eyebrow">work · case studies</p>
      <p class="work-intro">
        The evidence behind the outcomes. Each entry is a real project, with the decisions
        and the numbers that came out of it.
      </p>
    </section>

    <ProjectLedger
      items={ledgerItems}
      headingText="all case studies"
      emptyMessage="first case studies being written up."
    />
  </div>
</BaseLayout>

<style>
  .work {
    max-width: 960px;
    margin-inline: auto;
    padding: var(--s-7) var(--s-4) var(--s-8);
    display: flex;
    flex-direction: column;
    gap: var(--s-7);
  }

  .work-head {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .work-eyebrow {
    margin: 0;
  }

  .work-intro {
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 60ch;
    margin: 0;
  }

</style>
