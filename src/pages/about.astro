---
// About — the career narrative. Insight-first arc across 13 years, a short
// note on how Korab runs his own work, and a quiet close with contact links.
// Copy is disclosure-cleared per docs/plans/2026-07-03-console-mvp.md —
// the approved publication scope covers the experience and skills content;
// anything beyond it still needs sign-off.

import ExperienceLedger from "../components/ExperienceLedger/ExperienceLedger.astro";
import Portrait from "../components/Portrait/index.astro";
import PortraitPreload from "../components/Portrait/PortraitPreload.astro";
import SkillsSection from "../components/SkillsSection/SkillsSection.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { ABOUT_ANCHORS, ABOUT_NARRATIVE, ABOUT_OPERATE } from "../lib/about";
import { listExperience } from "../lib/experience";
import { serializeJsonLd } from "../lib/json-ld";
import { readSkills } from "../lib/skills";
import { STATUS } from "../lib/status";

const experience = await listExperience();
const skills = await readSkills();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://korabeland.com/about",
  url: "https://korabeland.com/about",
  name: "About · korab eland",
  description:
    "13 years across marketing, CX and operations. Now building AI systems for the same problems.",
  mainEntity: { "@id": "https://korabeland.com/#person" },
};

const PORTRAIT_SIZES = "(max-width: 680px) 280px, 440px";
---

<BaseLayout
  title="about · korab eland"
  description="13 years across marketing, CX and operations. Now building AI systems for the same problems. The career arc, how I operate, and how to reach me."
  active="about"
>
  <script is:inline type="application/ld+json" slot="jsonld" set:html={serializeJsonLd(jsonLd)} />
  <PortraitPreload slot="head" sizes={PORTRAIT_SIZES} />

  <article class="about">
    <header class="about-header">
      <p class="t-label">§ · about</p>
      <h1 class="t-display about-title">Turning ambiguous problems into systems</h1>
    </header>

    <figure class="about-portrait">
      <Portrait sizes={PORTRAIT_SIZES} />
      <figcaption class="t-mono about-portrait-cap">
        <span>korab eland</span>
        <span class="about-portrait-loc">{STATUS.baseReadout}</span>
      </figcaption>
    </figure>

    <section class="about-body" aria-labelledby={ABOUT_ANCHORS.narrative}>
      <h2 id={ABOUT_ANCHORS.narrative} class="sr-only">Career narrative</h2>
      {ABOUT_NARRATIVE.map((paragraph) => <p>{paragraph}</p>)}
    </section>

    <section class="about-operate" aria-labelledby={ABOUT_ANCHORS.operate}>
      <h2 id={ABOUT_ANCHORS.operate} class="t-label">how I operate</h2>
      <p>
        {ABOUT_OPERATE.before}{" "}
        <a href={ABOUT_OPERATE.link.href}>{ABOUT_OPERATE.link.text}</a>{" "}
        {ABOUT_OPERATE.after}
      </p>
    </section>

    {experience.length > 0 && <ExperienceLedger roles={experience} />}

    {skills && <SkillsSection data={skills} />}

    <section class="about-close" aria-labelledby={ABOUT_ANCHORS.close}>
      <h2 id={ABOUT_ANCHORS.close} class="sr-only">Contact</h2>
      <p class="t-mono about-authorization">{STATUS.aboutLine}</p>
      <p class="t-mono about-links">
        <a href="mailto:hello@korabeland.com">email</a> ·{" "}
        <a href="https://www.linkedin.com/in/korabeland" rel="me">linkedin</a>
      </p>
    </section>
  </article>
</BaseLayout>

<style>
  .about {
    max-width: var(--w-prose);
    margin-inline: auto;
    padding: var(--s-7) var(--s-4) var(--s-8);
  }

  .about-header {
    margin: 0 0 var(--s-6);
  }

  .about-portrait {
    margin: 0 0 var(--s-7);
    max-width: 440px;
    border: 1px solid var(--rule);
  }

  .about-portrait-cap {
    display: flex;
    justify-content: space-between;
    gap: var(--s-3);
    padding: var(--s-2) var(--s-3);
    border-top: 1px solid var(--rule);
  }

  .about-portrait-loc {
    color: var(--signal);
  }

  @media (max-width: 680px) {
    .about-portrait {
      max-width: 280px;
    }
  }

  .about-header .t-label {
    display: block;
    margin: 0 0 var(--s-3);
  }

  .about-title {
    font-size: clamp(28px, 5vw, 40px);
    max-width: 18ch;
    color: var(--ink);
    margin: 0;
  }

  .about-body {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .about-body p {
    font-size: 16px;
    line-height: 1.7;
    color: var(--ink-soft);
    margin: 0;
  }

  .about-operate {
    margin-top: var(--s-7);
    padding-top: var(--s-5);
    border-top: 1px solid var(--rule);
  }

  .about-operate .t-label {
    display: block;
    margin: 0 0 var(--s-3);
  }

  .about-operate p {
    font-size: 16px;
    line-height: 1.7;
    color: var(--ink-soft);
    margin: 0;
  }

  .about-operate a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .about-operate a:hover,
  .about-operate a:focus-visible {
    color: var(--signal);
  }

  .about :global(.experience-section) {
    margin-top: var(--s-7);
  }

  .about-close {
    margin-top: var(--s-7);
    padding-top: var(--s-5);
    border-top: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .about-authorization {
    text-transform: none;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
    font-size: 13px;
    line-height: 1.5;
    margin: 0;
  }

  .about-links {
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .about-links a {
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    transition: color 150ms ease, border-color 150ms ease;
  }

  .about-links a:hover,
  .about-links a:focus-visible {
    color: var(--signal);
    border-bottom-color: var(--signal);
  }

</style>
