---
// SSR: reads the ?from query param, so it can't be prerendered (opts out of
// the static-by-default build).
export const prerender = false;

import OffTrail from "../components/OffTrail/OffTrail.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { serializeJsonLd } from "../lib/json-ld";

const rawFrom = Astro.url.searchParams.get("from");
const KNOWN = new Set(["notes", "work"]);
const from = rawFrom && KNOWN.has(rawFrom) ? rawFrom : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://korabeland.com/off-trail",
  url: "https://korabeland.com/off-trail",
  name: "korabeland.com: page not found",
  description: "This page does not exist. Check back as the site grows.",
  isPartOf: { "@id": "https://korabeland.com/#website" },
};
---

<BaseLayout
  title="korabeland.com: page not found"
  description="This page does not exist. Check back as the site grows."
  noindex={true}
>
  <script is:inline type="application/ld+json" slot="jsonld" set:html={serializeJsonLd(jsonLd)} />
  <OffTrail from={from} />
</BaseLayout>
