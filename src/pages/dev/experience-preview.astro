---
export const prerender = false;

// Dev-only preview: renders ExperienceLedger against fixture roles so the
// section's markup is covered by e2e (AE1: a testimonial element appears only
// when a role has one) without committing Keystatic content that would ship to
// prod. Returns 404 in production; robots.txt disallows /dev/ and the sitemap
// filter excludes it. See docs/launch-readiness.md (the /dev/ recipe).

import ExperienceLedger from "../../components/ExperienceLedger/ExperienceLedger.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { ExperienceSummary } from "../../lib/experience";

if (import.meta.env.PROD) {
  return new Response("Not found", { status: 404 });
}

const roles: ExperienceSummary[] = [
  {
    slug: "current-role",
    company: "Current Co",
    role: "Operations Lead",
    location: "Melbourne",
    startDate: "2021-02-01",
    endDate: null,
    current: true,
    achievements: [
      {
        text: "Rebuilt triage so the team acts on evidence, not hunches.",
        metric: { value: "30–50%", label: "less manual effort" },
      },
      {
        text: "Aligned four functions before a line of code was written.",
        metric: { value: "6", label: "stakeholders" },
      },
    ],
    tags: ["operations", "evidence"],
    testimonial: {
      quote: "Framed the problem nobody had framed, then built the fix.",
      attribution: "A manager",
      sourceUrl: null,
    },
  },
  {
    slug: "prior-role",
    company: "Prior Co",
    role: "Marketing Manager",
    location: "Melbourne",
    startDate: "2017-06-01",
    endDate: "2021-01-01",
    current: false,
    achievements: [
      {
        text: "Led a channel-mix overhaul across paid search and social.",
        metric: null,
      },
    ],
    tags: ["marketing"],
    testimonial: null,
  },
];
---

<BaseLayout title="dev · experience preview" noindex={true}>
  <div class="dev-preview">
    <ExperienceLedger roles={roles} />
  </div>
</BaseLayout>

<style>
  .dev-preview {
    max-width: 960px;
    margin-inline: auto;
    padding: var(--s-6) var(--s-4);
  }
</style>
