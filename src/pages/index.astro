---
// Home — the console. Positioning first, then the outcome ledger (real
// case studies from the projects collection), recent notes, and a quiet
// contact line. See docs/plans/2026-07-03-console-mvp.md.

import { existsSync, readFileSync } from "node:fs";
import { resolve } from "node:path";
import ExperienceLedger from "../components/ExperienceLedger/ExperienceLedger.astro";
import Portrait from "../components/Portrait/index.astro";
import ProjectLedger from "../components/ProjectLedger/index.astro";
import SectionHead from "../components/SectionHead.astro";
import ShiftLog from "../components/ShiftLog/ShiftLog.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { listExperience } from "../lib/experience";
import { serializeJsonLd } from "../lib/json-ld";
import { formatNoteMonth, listPosts } from "../lib/posts";
import { listProjects, projectHref, projectStatus } from "../lib/projects";
import type { ContributionData } from "../lib/shift-log";
import { STATUS } from "../lib/status";

const projects = await listProjects();
// Work case studies and personal AI tinkering render as separate bands and
// never interleave (the site's hard work/lab split). Home features the top
// three case studies (ship-date order from the reader); the full set lives
// at /work via the ledger's more-link, the lab set at /lab.
const workProjects = projects.filter((p) => p.category === "work");
const labProjects = projects.filter((p) => p.category === "side");
const ledgerItems = workProjects.slice(0, 3).map((p) => ({
  slug: p.slug,
  title: p.title,
  outcome: p.outcome,
  status: projectStatus(p),
  href: projectHref(p),
}));
const labItems = labProjects.map((p) => ({
  slug: p.slug,
  title: p.title,
  outcome: p.outcome,
  status: projectStatus(p),
  href: projectHref(p),
}));
const experience = await listExperience();
const posts = (await listPosts()).slice(0, 3);

// Shift log — a year of GitHub activity, the same generated-then-seed pipeline
// the colophon build log uses. Content-gated: the band renders only when real
// data is present. The prebuild hook (`scripts/gen-shift-log.ts`) writes
// contributions.json; the committed seed is the tokenless fallback.
const shiftLogRoot = resolve(process.cwd(), "src/content/shift-log");

function loadContributions(): ContributionData | null {
  // Only prefer the gitignored live file in a production build. In dev and
  // under Playwright (which runs `pnpm dev`), a leftover contributions.json
  // from an earlier tokened build would otherwise get screenshotted and drift
  // the visual baselines the committed seed exists to keep stable.
  const candidates = import.meta.env.PROD
    ? ["contributions.json", "contributions.seed.json"]
    : ["contributions.seed.json"];
  for (const name of candidates) {
    const file = resolve(shiftLogRoot, name);
    if (!existsSync(file)) continue;
    try {
      const raw = JSON.parse(readFileSync(file, "utf8"));
      if (
        raw &&
        typeof raw === "object" &&
        Array.isArray(raw.weeks) &&
        raw.weeks.length > 0 &&
        typeof raw.total === "number" &&
        typeof raw.fetchedAt === "string"
      ) {
        return raw as ContributionData;
      }
    } catch {
      // fall through to the next candidate
    }
  }
  return null;
}

const contributions = loadContributions();

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://korabeland.com/#person",
      name: "Korab Eland",
      url: "https://korabeland.com",
      description: STATUS.personDescription,
      sameAs: [
        "https://www.linkedin.com/in/korabeland",
        "https://github.com/korabeland",
      ],
      address: {
        "@type": "PostalAddress",
        addressLocality: "Melbourne",
        addressCountry: "AU",
      },
      nationality: STATUS.nationalities.map((name) => ({
        "@type": "Country",
        name,
      })),
    },
    {
      "@type": "WebSite",
      "@id": "https://korabeland.com/#website",
      url: "https://korabeland.com",
      name: "korabeland.com",
      publisher: { "@id": "https://korabeland.com/#person" },
    },
  ],
};

// Social marks for the portrait caption — filled brand glyphs, inlined so they
// inherit currentColor (they track --ink-soft/--signal on hover). Same
// icon-const idiom as ShiftToggle. Order: email, LinkedIn, GitHub, X.
const X_ICON =
  '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>';
const LINKEDIN_ICON =
  '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>';
const GITHUB_ICON =
  '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>';
const MAIL_ICON =
  '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67Z"/><path d="M22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908Z"/></svg>';
---

<BaseLayout
  title="korab eland"
  description="I turn ambiguous problems into systems that ship. 13 years across marketing, CX and operations. Now building the AI-driven kind."
  active="home"
  ogImage="/og.png"
>
  <script is:inline type="application/ld+json" slot="jsonld" set:html={serializeJsonLd(jsonLd)} />
  {/* Preload the night portrait (the home LCP element on mobile) so the
      fetch starts at head-parse instead of when the parser reaches the
      hero <picture> (~700ms later on slow-4G). Mirrors the AVIF srcset
      Portrait renders — tests/e2e/hero-delivery.spec.ts guards the two
      against drift. Night only: it's the no-JS/default variant. */}
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/avif"
    imagesrcset="/portrait/portrait-illustrated.gen.360.avif 360w, /portrait/portrait-illustrated.gen.720.avif 720w, /portrait/portrait-illustrated.gen.1040.avif 1040w"
    imagesizes="(max-width: 680px) 240px, 340px"
    fetchpriority="high"
  />

  <div class="home">
    <!-- ─── Hero: the readout ─────────────────────────────────────────── -->
    <section class="hero" aria-labelledby="hero-heading">
      <div class="hero-text">
        <h1 id="hero-heading" class="t-display hero-title">
          I turn ambiguous problems into systems that <span class="hero-ship"><span class="sr-only">ship</span><span class="hero-ship-word" aria-hidden="true">ship</span></span>.
        </h1>
        <p class="hero-sub">
          13 years across marketing, CX and operations. Now building the AI-driven kind:
          evidence in, decisions out.
        </p>
        <p class="t-mono hero-reloc">{STATUS.heroReadout}</p>
      </div>
      <div class="hero-aside">
        <figure class="hero-portrait">
          <Portrait sizes="(max-width: 680px) 240px, 340px" gaze />
          <figcaption class="t-mono hero-portrait-cap">
            <span>/korabeland</span>
            <span class="hero-social">
              <a
                class="hero-social-link"
                href="mailto:hello@korabeland.com"
                target="_blank"
                aria-label="Email Korab Eland"
                data-gaze-target
                set:html={MAIL_ICON}
              />
              <a
                class="hero-social-link"
                href="https://www.linkedin.com/in/korabeland"
                target="_blank"
                rel="me noopener noreferrer"
                aria-label="Korab Eland on LinkedIn"
                data-gaze-target
                set:html={LINKEDIN_ICON}
              />
              <a
                class="hero-social-link"
                href="https://github.com/korabeland"
                target="_blank"
                rel="me noopener noreferrer"
                aria-label="Korab Eland on GitHub"
                data-gaze-target
                set:html={GITHUB_ICON}
              />
              <a
                class="hero-social-link"
                href="https://x.com/korabeland"
                target="_blank"
                rel="me noopener noreferrer"
                aria-label="Korab Eland on X"
                data-gaze-target
                set:html={X_ICON}
              />
            </span>
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- ─── Outcome ledger ────────────────────────────────────────────── -->
    <ProjectLedger
      items={ledgerItems}
      headingText="work · outcome ledger"
      moreLink={{ href: "/work", label: "all case studies →" }}
      emptyMessage="first case studies being written up · check back shortly"
      stagger
    />

    <!-- ─── Shift log ── a year of building, straight from GitHub ───────── -->
    {
      contributions && (
        <section class="shift-section" aria-labelledby="shift-heading">
          <SectionHead
            id="shift-heading"
            text="shift log · a year of building"
            more={{
              href: "https://github.com/korabeland",
              label: "on github →",
              rel: "me",
            }}
          />
          <ShiftLog data={contributions} />
        </section>
      )
    }

    <!-- ─── Lab ── AI code tinkering, kept apart from the work ledger ───── -->
    {
      labItems.length > 0 && (
        <ProjectLedger
          items={labItems}
          headingId="lab-heading"
          headingText="lab · AI code tinkering"
          moreLink={{ href: "/lab", label: "all tinkering →" }}
          emptyMessage="first tinkering project being written up."
        />
      )
    }

    <!-- ─── Experience ── renders only once real roles exist in Keystatic ── -->
    {experience.length > 0 && <ExperienceLedger roles={experience} />}

    <!-- ─── Recent notes ──────────────────────────────────────────────── -->
    {
      posts.length > 0 && (
        <section class="notes-section" aria-labelledby="notes-heading">
          <SectionHead
            id="notes-heading"
            text="recent notes"
            more={{ href: "/notes", label: "all notes →" }}
          />
          <ul class="notes-list">
            {posts.map((post) => (
              <li class="notes-row">
                <a class="notes-link" href={`/notes/${post.slug}`}>
                  <span class="notes-title">{post.title}</span>
                  <span class="t-mono notes-meta">
                    {formatNoteMonth(post.publishedAt)} · {post.readTime}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- ─── About teaser + contact ────────────────────────────────────── -->
    <section class="close-section" aria-labelledby="close-heading">
      <SectionHead id="close-heading" text="the short version" />
      <p class="close-body">
        Media buyer, then marketer, then CX manager, now building AI systems inside a real
        business. I lead with evidence and design pilots that survive the handoff. Everything
        gets written down. The longer version is on the <a href="/about">about page</a>; the receipts are in
        the <a href="/work">case studies</a>.
      </p>
      <p class="t-mono close-contact">
        <a href="mailto:hello@korabeland.com">hello@korabeland.com</a> ·
        <a href="https://www.linkedin.com/in/korabeland" rel="me">linkedin</a>
      </p>
    </section>
  </div>

  <script>
    // Rotating hero subject. The h1 server-renders the default ("ship"); this
    // swaps the visible (aria-hidden) word on an interval with a short fade.
    // Disabled under prefers-reduced-motion or with a single phrase, so no-JS
    // and reduced-motion visitors keep the static default (AE2). The accessible
    // name is the stable sr-only word, so assistive tech re-announces nothing.
    const heroWord = document.querySelector<HTMLElement>(".hero-ship-word");
    const heroReduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const heroPhrases = ["ship", "scale", "last", "compound"];
    if (heroWord && !heroReduce.matches && heroPhrases.length > 1) {
      let heroIndex = 0;
      window.setInterval(() => {
        heroIndex = (heroIndex + 1) % heroPhrases.length;
        heroWord.style.opacity = "0";
        window.setTimeout(() => {
          heroWord.textContent = heroPhrases[heroIndex];
          heroWord.style.opacity = "1";
        }, 220);
      }, 2800);
    }
  </script>
</BaseLayout>

<style>
  .home {
    max-width: var(--w-shell);
    margin-inline: auto;
    padding: var(--s-7) var(--s-4) var(--s-8);
    display: flex;
    flex-direction: column;
    gap: var(--s-8);
  }

  /* ─── Hero — split readout: text left, framed portrait right ────────── */

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: var(--s-7);
    align-items: start;
  }

  .hero-title {
    font-size: clamp(34px, 5vw, 48px);
    margin: 0 0 var(--s-4);
    max-width: 18ch;
    color: var(--ink);
  }

  .hero-ship {
    color: var(--signal);
  }

  /* The accessible name stays "…systems that ship." — the sr-only word
     (global utility) is the stable label; the visible word rotates and is
     hidden from assistive tech. */
  .hero-ship-word {
    transition: opacity 220ms ease;
  }

  .hero-sub {
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 52ch;
    margin: 0;
  }

  .hero-reloc {
    color: var(--ink-soft);
    margin: var(--s-4) 0 0;
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .hero-aside {
    justify-self: end;
    max-width: 340px;
    width: 100%;
  }

  .hero-portrait {
    margin: 0;
    border: 1px solid var(--rule);
  }

  .hero-portrait-cap {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-2) var(--s-3);
    border-top: 1px solid var(--rule);
  }

  /* Social marks — a quiet row of brand glyphs on the right of the caption,
     opposite the name. They sit at --ink-soft and warm to --signal on hover,
     the same signal-on-hover idiom the rest of the console uses. */
  .hero-social {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
  }

  .hero-social-link {
    display: inline-flex;
    color: var(--ink-soft);
    transition: color 150ms ease;
  }

  .hero-social-link:hover,
  .hero-social-link:focus-visible {
    color: var(--signal);
  }

  .hero-social-link :global(svg) {
    display: block;
    width: 15px;
    height: 15px;
  }

  /* ─── Shift log band — the contribution grid brings its own styles; the
     section only needs to space it below the section head ──────────────── */

  .shift-section :global(.shiftlog) {
    margin-top: var(--s-4);
  }

  /* ─── Recent notes ─────────────────────────────────────────────────── */

  .notes-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .notes-row {
    border-bottom: 1px solid var(--rule);
  }

  .notes-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-5);
    padding: var(--s-3) var(--s-2);
    text-decoration: none;
    transition: background 150ms ease;
  }

  @media (hover: hover) {
    .notes-link:hover {
      background: var(--paper-2);
    }
  }

  .notes-title {
    font-size: 15.5px;
    color: var(--ink);
    line-height: 1.4;
  }

  .notes-meta {
    text-transform: none;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  /* ─── Close ────────────────────────────────────────────────────────── */

  .close-body {
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink-soft);
    max-width: 58ch;
    margin: var(--s-4) 0 0;
  }

  .close-body a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .close-body a:hover,
  .close-body a:focus-visible {
    color: var(--signal);
  }

  .close-contact {
    margin: var(--s-4) 0 0;
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .close-contact a {
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    transition: color 150ms ease, border-color 150ms ease;
  }

  .close-contact a:hover,
  .close-contact a:focus-visible {
    color: var(--signal);
    border-bottom-color: var(--signal);
  }

  @media (max-width: 680px) {
    .hero {
      grid-template-columns: 1fr;
      gap: var(--s-6);
    }
    .hero-aside {
      max-width: 240px;
      justify-self: start;
    }
  }
</style>
