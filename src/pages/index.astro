---
export const prerender = true;

// Home — the console. Positioning first, then the outcome ledger (real
// case studies from the projects collection), recent notes, and a quiet
// contact line. See docs/plans/2026-07-03-console-mvp.md.

import BaseLayout from "../layouts/BaseLayout.astro";
import { listPosts } from "../lib/posts";
import { listProjects } from "../lib/projects";

const projects = await listProjects();
const posts = (await listPosts()).slice(0, 3);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://korabeland.com/#person",
      name: "Korab Eland",
      url: "https://korabeland.com",
      description:
        "Operator with 13 years across marketing, CX and operations. Turns ambiguous problems into systems that ship, now building with AI.",
      sameAs: ["https://www.linkedin.com/in/korabeland"],
      address: {
        "@type": "PostalAddress",
        addressLocality: "Melbourne",
        addressCountry: "AU",
      },
    },
    {
      "@type": "WebSite",
      "@id": "https://korabeland.com/#website",
      url: "https://korabeland.com",
      name: "korabeland.com",
      publisher: { "@id": "https://korabeland.com/#person" },
    },
  ],
};

function ledgerStatus(p: { shippedAt: string | null }): {
  label: string;
  kind: "shipped" | "active";
} {
  return p.shippedAt
    ? { label: "shipped", kind: "shipped" }
    : { label: "in flight", kind: "active" };
}

function formatDate(iso: string | null): string {
  if (!iso) return "";
  return new Date(iso)
    .toLocaleDateString("en-AU", { year: "numeric", month: "short" })
    .toLowerCase();
}
---

<BaseLayout
  title="korab eland — operator · builds with ai"
  description="I turn ambiguous problems into systems that ship. 13 years across marketing, CX and operations. Now building the AI-driven kind."
  active="home"
  ogImage="/og.png"
>
  <script type="application/ld+json" slot="jsonld" set:html={JSON.stringify(jsonLd)} />

  <div class="home">
    <!-- ─── Hero: the readout ─────────────────────────────────────────── -->
    <section class="hero" aria-labelledby="hero-heading">
      <p class="t-label hero-eyebrow">korab eland · operator · melbourne</p>
      <h1 id="hero-heading" class="t-display hero-title">
        I turn ambiguous problems into systems that <span class="hero-ship">ship</span>.
      </h1>
      <p class="hero-sub">
        13 years across marketing, CX and operations. Now building the AI-driven kind:
        evidence in, decisions out, designed for handoff.
      </p>
    </section>

    <!-- ─── Outcome ledger ────────────────────────────────────────────── -->
    <section class="ledger-section" aria-labelledby="ledger-heading">
      <div class="section-head">
        <h2 id="ledger-heading" class="t-label">work · outcome ledger</h2>
        <a class="t-mono section-more" href="/work">all case studies →</a>
      </div>

      {
        projects.length > 0 ? (
          <ol class="ledger">
            {projects.map((p, i) => {
              const status = ledgerStatus(p);
              return (
                <li class="ledger-row" style={`--row: ${i}`}>
                  <a class="ledger-link" href={`/work/${p.slug}`}>
                    <span class="ledger-name">{p.title}</span>
                    <span class="t-mono ledger-datum">{p.outcome}</span>
                    <span class={`ledger-chip ledger-chip--${status.kind}`}>{status.label}</span>
                  </a>
                </li>
              );
            })}
          </ol>
        ) : (
          <p class="t-mono ledger-empty">first case studies being written up · check back shortly</p>
        )
      }
    </section>

    <!-- ─── Recent notes ──────────────────────────────────────────────── -->
    {
      posts.length > 0 && (
        <section class="notes-section" aria-labelledby="notes-heading">
          <div class="section-head">
            <h2 id="notes-heading" class="t-label">recent notes</h2>
            <a class="t-mono section-more" href="/notes">
              all notes →
            </a>
          </div>
          <ul class="notes-list">
            {posts.map((post) => (
              <li class="notes-row">
                <a class="notes-link" href={`/notes/${post.slug}`}>
                  <span class="notes-title">{post.title}</span>
                  <span class="t-mono notes-meta">
                    {formatDate(post.publishedAt)} · {post.readTime}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- ─── About teaser + contact ────────────────────────────────────── -->
    <section class="close-section" aria-labelledby="close-heading">
      <h2 id="close-heading" class="t-label">the short version</h2>
      <p class="close-body">
        Media buyer, then marketer, then CX manager, now building AI systems inside a real
        business. I lead with evidence, design pilots for handoff, and document everything.
        The longer version is on the <a href="/about">about page</a>; the receipts are in
        the <a href="/work">case studies</a>.
      </p>
      <p class="t-mono close-contact">
        <a href="mailto:korabeland@gmail.com">korabeland@gmail.com</a> ·
        <a href="https://www.linkedin.com/in/korabeland" rel="me">linkedin</a>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    max-width: 960px;
    margin-inline: auto;
    padding: var(--s-7) var(--s-4) var(--s-8);
    display: flex;
    flex-direction: column;
    gap: var(--s-8);
  }

  /* ─── Hero ─────────────────────────────────────────────────────────── */

  .hero-eyebrow {
    color: var(--ink-soft);
    margin: 0 0 var(--s-4);
  }

  .hero-title {
    font-size: clamp(34px, 6vw, 52px);
    margin: 0 0 var(--s-4);
    max-width: 18ch;
    color: var(--ink);
  }

  .hero-ship {
    color: var(--amber);
  }

  .hero-sub {
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 52ch;
    margin: 0;
  }

  /* ─── Section chrome ───────────────────────────────────────────────── */

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-4);
    border-bottom: 1px solid var(--ink);
    padding-bottom: var(--s-2);
  }

  .section-head h2 {
    margin: 0;
    color: var(--ink-soft);
  }

  .section-more {
    text-transform: none;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    text-decoration: none;
  }

  .section-more:hover,
  .section-more:focus-visible {
    color: var(--amber);
  }

  /* ─── Outcome ledger — motion moment 1 of 3: rows stagger in once ──── */

  .ledger {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ledger-row {
    border-bottom: 1px solid var(--rule);
    animation: reveal 0.45s ease both;
    animation-delay: calc(var(--row) * 60ms);
  }

  .ledger-link {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--s-5);
    padding: var(--s-4) var(--s-2);
    text-decoration: none;
    transition: background 150ms ease;
  }

  @media (hover: hover) {
    .ledger-link:hover {
      background: var(--paper-2);
    }
  }

  .ledger-name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 17px;
    color: var(--ink);
    line-height: 1.35;
  }

  .ledger-datum {
    text-transform: none;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
  }

  .ledger-chip {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 3px 8px;
    border: 1px solid;
    white-space: nowrap;
  }

  .ledger-chip--active {
    color: var(--amber);
    border-color: var(--amber);
  }

  .ledger-chip--shipped {
    color: var(--moss);
    border-color: var(--moss);
  }

  .ledger-empty {
    padding: var(--s-5) var(--s-2);
    margin: 0;
  }

  /* ─── Recent notes ─────────────────────────────────────────────────── */

  .notes-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .notes-row {
    border-bottom: 1px solid var(--rule);
  }

  .notes-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-5);
    padding: var(--s-3) var(--s-2);
    text-decoration: none;
    transition: background 150ms ease;
  }

  @media (hover: hover) {
    .notes-link:hover {
      background: var(--paper-2);
    }
  }

  .notes-title {
    font-size: 15.5px;
    color: var(--ink);
    line-height: 1.4;
  }

  .notes-meta {
    text-transform: none;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  /* ─── Close ────────────────────────────────────────────────────────── */

  .close-section .t-label {
    display: block;
    border-bottom: 1px solid var(--ink);
    padding-bottom: var(--s-2);
    color: var(--ink-soft);
  }

  .close-body {
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink-soft);
    max-width: 58ch;
    margin: var(--s-4) 0 0;
  }

  .close-body a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .close-body a:hover,
  .close-body a:focus-visible {
    color: var(--amber);
  }

  .close-contact {
    margin: var(--s-4) 0 0;
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .close-contact a {
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    transition: color 150ms ease, border-color 150ms ease;
  }

  .close-contact a:hover,
  .close-contact a:focus-visible {
    color: var(--amber);
    border-bottom-color: var(--amber);
  }

  @media (max-width: 680px) {
    .ledger-link {
      grid-template-columns: 1fr auto;
    }
    .ledger-datum {
      grid-column: 1 / -1;
      order: 3;
    }
  }
</style>
