---
import { existsSync, readFileSync } from "node:fs";
import { resolve } from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import type { ColophonStatsData } from "../lib/colophon-stats";
import {
  formatHumanDate,
  formatHumanDateRange,
  isValidColophonStats,
  meterSegments,
} from "../lib/colophon-stats";
import { serializeJsonLd } from "../lib/json-ld";

const trailRegisterRoot = resolve(process.cwd(), "src/content/trail-register");

interface CommitEntry {
  sha: string;
  shortSha: string;
  subject: string;
  author: string;
  date: string;
}

// The prebuild hook (`scripts/gen-trail-register.ts`) writes commits.json from
// `git log`. The seed file is the committed fallback for shallow Vercel clones
// that don't run the hook.
// Only prefer the gitignored live file in a production build — same guard as
// the shift-log's loadContributions (src/pages/index.astro). Under Playwright
// (`pnpm dev`, whose predev regenerates commits.json) the live log changes
// with EVERY commit, which made the colophon's visual baselines stale the
// moment anything landed. The committed seed keeps screenshots deterministic.
function loadCommits(): CommitEntry[] {
  const candidates = import.meta.env.PROD
    ? ["commits.json", "commits.seed.json"]
    : ["commits.seed.json"];
  for (const name of candidates) {
    const file = resolve(trailRegisterRoot, name);
    if (!existsSync(file)) continue;
    try {
      const raw = JSON.parse(readFileSync(file, "utf8"));
      if (Array.isArray(raw) && raw.length > 0) {
        return raw as CommitEntry[];
      }
    } catch {
      // fall through to the next candidate
    }
  }
  return [];
}

function loadColophonStats(): ColophonStatsData | null {
  const candidates = import.meta.env.PROD
    ? ["stats.json", "stats.seed.json"]
    : ["stats.seed.json"];
  for (const name of candidates) {
    const file = resolve(trailRegisterRoot, name);
    if (!existsSync(file)) continue;
    try {
      const raw: unknown = JSON.parse(readFileSync(file, "utf8"));
      if (isValidColophonStats(raw)) {
        return raw;
      }
    } catch {
      // fall through to the next candidate
    }
  }
  return null;
}

function formatCommitDate(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso;
  const yyyy = d.getFullYear();
  const mm = String(d.getMonth() + 1).padStart(2, "0");
  const dd = String(d.getDate()).padStart(2, "0");
  return `${yyyy}.${mm}.${dd}`;
}

function statsSource(metric: {
  source: "live" | "seed";
  asOf: string;
}): string {
  return `${metric.source === "live" ? "Live" : "Snapshot"} as of ${formatHumanDate(metric.asOf)}`;
}

// Human-relative age for the featured commit — "shipped today / yesterday /
// N days ago". Computed at build time (the page rebuilds on every push), so
// it is accurate as of each deploy without any client JS.
function relativeTime(iso: string): string {
  const then = new Date(iso).getTime();
  if (Number.isNaN(then)) return "";
  const days = Math.floor((Date.now() - then) / 86_400_000);
  if (days <= 0) return "today";
  if (days === 1) return "yesterday";
  if (days < 7) return `${days} days ago`;
  const weeks = Math.floor(days / 7);
  if (weeks === 1) return "last week";
  if (days < 30) return `${weeks} weeks ago`;
  const months = Math.floor(days / 30);
  return months === 1 ? "last month" : `${months} months ago`;
}

const commits = loadCommits().slice(0, 14);
const [featured, ...rest] = commits;
const stats = loadColophonStats();

const prMeter = stats
  ? meterSegments(
      stats.pullRequests.mergedCount,
      stats.pullRequests.closedUnmergedCount,
    )
  : null;
const modelMeter = stats
  ? meterSegments(
      stats.commits.modelTrailerCommits,
      stats.commits.totalCommits - stats.commits.modelTrailerCommits,
    )
  : null;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://korabeland.com/colophon",
  url: "https://korabeland.com/colophon",
  name: "korabeland.com: colophon",
  description: "How korabeland.com was built and the tools used.",
  isPartOf: { "@id": "https://korabeland.com/#website" },
};

const tools: { label: string; note: string }[] = [
  { label: "Astro 7", note: "page routing, server output via Vercel adapter" },
  {
    label: "Tailwind CSS 4",
    note: "CSS-first configuration; tokens in src/styles/tokens.css",
  },
  {
    label: "shadcn/ui + React 19",
    note: "interactive islands where they earn their weight",
  },
  { label: "Keystatic", note: "local-git-backed CMS for long-form posts" },
  { label: "Vercel", note: "hosting, preview deploys, edge functions" },
  {
    label: "firstmate + Claude, Codex, and Gemini agents",
    note: "the supervised agent crew building this site",
  },
];
---

<BaseLayout
  title="korabeland.com: colophon"
  description="How korabeland.com was built and the tools used."
  active="colophon"
>
  <script is:inline type="application/ld+json" slot="jsonld" set:html={serializeJsonLd(jsonLd)} />
  <article class="prose colophon">
    <header>
      <p class="t-label">§ · colophon</p>
      <h1>Colophon</h1>
      <p class="lede">
        A record of how this site was built. For who built it, see
        {" "}<a href="/about">about</a>.
      </p>
    </header>

    {stats && prMeter && modelMeter && (
      <section aria-labelledby="built-with-ai" class="ai-split">
        <h2 id="built-with-ai">Built with AI, decided by me</h2>
        <p class="ai-split-lede">
          Agents write every change to this site. I make every request, design
          pick, and merge call.
        </p>
        <p>
          A supervising agent, my first mate (running on the open-source{" "}
          <a href="https://github.com/kunchenguid/firstmate">firstmate</a>{" "}
          supervisor), is my single point of contact. It never edits the site
          itself. When I state what I want in plain English, it writes a task
          brief, picks a worker model, and starts that worker in an isolated
          copy of the repository so parallel jobs cannot collide. Each worker
          runs its change through <code>no-mistakes</code>: a model from a
          different family reviews the diff before type checks, unit tests,
          Playwright browser tests, Lighthouse performance budgets, and a
          production smoke check run. Clear review findings get fixed in the
          pipeline; ambiguous product or design decisions come back to me as a
          question. No agent can merge to <code>main</code> on its own.
        </p>

        <div
          class="split-grid"
          role="group"
          aria-label="Division of work between agents and Korab"
        >
          <div class="split-card">
            <p class="t-label split-card-label">agents build</p>
            <ul class="split-list">
              <li>Write code, styles, and tests in an isolated repo copy</li>
              <li>Review every diff with a model from a different family</li>
              <li>Fix lint, test, accessibility, and Lighthouse findings</li>
              <li>Open the pull request and attach preview screenshots</li>
            </ul>
          </div>
          <div class="split-card split-card--decider">
            <p class="t-label split-card-label">I decide</p>
            <ul class="split-list">
              <li>State what to build and why in plain English</li>
              <li>Set the design rules, voice, and scope boundaries</li>
              <li>Answer product and design questions surfaced by review</li>
              <li>Inspect the preview and approve or reject every merge</li>
            </ul>
          </div>
        </div>

        <div class="ai-stats" role="group" aria-label="Repository numbers">
          <div class="ai-stat-card" data-stat="shipped">
            <div class="ai-stat-head">
              <span class="t-label ai-stat-title">changes shipped</span>
              <span class="t-mono ai-stat-value ai-stat-value--shipped">
                {stats.pullRequests.mergedCount} merged pull requests
              </span>
            </div>
            <svg
              class="ai-meter-svg"
              viewBox="0 0 1000 8"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <rect
                class="ai-meter-shipped"
                x="0"
                y="0"
                width={prMeter.primaryWidth}
                height="8"
              />
              <rect
                class="ai-meter-returned"
                x={prMeter.secondaryX}
                y="0"
                width={prMeter.secondaryWidth}
                height="8"
              />
            </svg>
            <p class="t-mono small ai-meter-caption">
              {stats.pullRequests.mergedCount} merged ({prMeter.primaryPercent}%) · {stats.pullRequests.closedUnmergedCount} closed unmerged · {stats.commits.totalCommits} commits on main
            </p>
            <p class="ai-stat-meta">
              <strong>Date range:</strong>{" "}
              {formatHumanDateRange(stats.pullRequests.mergedRange)} for pull
              requests ({formatHumanDateRange(stats.commits.commitRange)} for
              commits on <code>main</code>).{" "}
              <strong>Source:</strong> public GitHub pull requests on{" "}
              <code>korabeland/korabeland.com</code> and <code>git log</code>.
              {" "}<strong>Pull-request data:</strong>{" "}
              {statsSource(stats.pullRequests)}. <strong>Commit data:</strong>{" "}
              {statsSource(stats.commits)}.
            </p>
          </div>

          <div class="ai-stat-card" data-stat="returned">
            <div class="ai-stat-head">
              <span class="t-label ai-stat-title">changes sent back</span>
              <span class="t-mono ai-stat-value ai-stat-value--returned">
                {stats.pullRequests.closedUnmergedCount} closed without merging
              </span>
            </div>
            <p class="t-mono small ai-meter-caption">
              {stats.commits.noMistakesRounds} automated pipeline fix rounds across {stats.commits.noMistakesCommits} merged pull requests ({formatHumanDateRange(stats.commits.recentRange)})
            </p>
            <p class="ai-stat-meta">
              <strong>Date range:</strong>{" "}
              {formatHumanDateRange(stats.pullRequests.mergedRange)} (closed
              between{" "}
              {formatHumanDateRange(stats.pullRequests.closedUnmergedRange)}).{" "}
              <strong>Source:</strong> public GitHub pull requests closed with{" "}
              <code>merged_at: null</code>, plus{" "}
              <code>no-mistakes</code> fix commits in <code>git log</code>.
              Rework and direction calls I make inside a branch before merge
              are not recorded as separate events in the public repo.
              <strong>Data status:</strong> pull requests {statsSource(stats.pullRequests)};
              commits {statsSource(stats.commits)}.
            </p>
          </div>

          <div class="ai-stat-card" data-stat="models">
            <div class="ai-stat-head">
              <span class="t-label ai-stat-title">models used</span>
              <span class="t-mono ai-stat-value">
                {stats.commits.modelTrailerCommits} of {stats.commits.totalCommits} commits name a model in git
              </span>
            </div>
            <svg
              class="ai-meter-svg"
              viewBox="0 0 1000 8"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <rect
                class="ai-meter-signal"
                x="0"
                y="0"
                width={modelMeter.primaryWidth}
                height="8"
              />
              <rect
                class="ai-meter-untagged"
                x={modelMeter.secondaryX}
                y="0"
                width={modelMeter.secondaryWidth}
                height="8"
              />
            </svg>
            <p class="t-mono small ai-meter-caption">
              {stats.commits.modelTrailerCommits} commits with a Claude trailer ({modelMeter.primaryPercent}%) · {stats.commits.unattributedRecentCommits} commits since {formatHumanDate(stats.commits.recentRange.startDate)} with no model tag in git
            </p>
            <p class="ai-stat-meta">
              <strong>Date range:</strong>{" "}
              {formatHumanDateRange(stats.commits.modelTrailerRange)} for git
              model trailers; {formatHumanDateRange(stats.commits.recentRange)}{" "}
              for the current multi-model crew.{" "}
              <strong>Source:</strong> <code>Co-authored-by</code> trailers in{" "}
              <code>git log</code> and review logs in{" "}
              <code>docs/reviews/</code>. Direct Claude Code commits through
              August 2026 stamped a Claude Opus or Sonnet trailer into git.
              Earlier work also committed OpenAI Codex review logs. Since
              October 2026, the first mate routes work across Anthropic Claude
              (Opus, Sonnet, Haiku), OpenAI Codex, and Google Gemini (Argon),
              with cross-family review, and does not write a model tag into
              commits or pull requests. The public repo does not record a
              per-model count for those recent changes.
              <strong>Data status:</strong> {statsSource(stats.commits)}.
            </p>
          </div>
        </div>
      </section>
    )}

    {commits.length > 0 && (
      <section aria-labelledby="build-log" class="build-log">
        <h2 id="build-log">Build log</h2>
        <p class="build-log-lede">Every change to this site, in the open.</p>

        {/* featured is always defined here: commits.length > 0 guarantees it */}
        <div class="commit-featured">
          <div class="commit-featured-top">
            <span class="commit-sha t-mono">{featured.shortSha}</span>
            <time class="commit-when t-mono" datetime={featured.date}>
              shipped {relativeTime(featured.date)}
            </time>
          </div>
          <p class="commit-featured-subject t-mono">{featured.subject}</p>
        </div>

        {rest.length > 0 && (
          <ol class="commit-list" aria-label="Earlier commits">
            {rest.map((commit) => (
              <li class="commit">
                <span class="commit-sha t-mono">{commit.shortSha}</span>
                <span class="commit-subject t-mono">{commit.subject}</span>
                <time class="commit-date t-mono" datetime={commit.date}>
                  {formatCommitDate(commit.date)}
                </time>
              </li>
            ))}
          </ol>
        )}

        {/* R14: the one visible confirmation that the portrait's glance is
            deliberate, for a visitor who noticed it. No hype, no em dash. */}
        <p class="t-mono small build-log-note">
          the hero portrait's gaze follows your cursor on purpose: a measured,
          test-covered rig that rests for reduced-motion and touch.
        </p>
      </section>
    )}

    <section aria-labelledby="stack">
      <h2 id="stack">Tools and stack</h2>
      <p>
        The site is small on purpose. The build pipeline does most of the
        work behind the scenes.
      </p>
      <ul>
        {tools.map((tool) => (
          <li>
            <strong>{tool.label}</strong>: {tool.note}
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="contact">
      <h2 id="contact">Get in touch</h2>
      <p>
        The fastest path is email:
        {" "}
        <a href="mailto:hello@korabeland.com">hello@korabeland.com</a>.
      </p>
      <p class="t-mono small">
        The outcome ledger on the home page will keep filling in as the work does.
      </p>
    </section>
  </article>
</BaseLayout>

<style>
  .colophon {
    max-width: var(--w-prose);
    margin-inline: auto;
    padding-block: var(--s-5) var(--s-8);
  }

  .colophon .t-mono {
    margin: 0 0 var(--s-3);
  }

  .colophon .lede {
    margin: 0 0 var(--s-5);
  }

  /* ─── Built with AI, decided by me ───────────────────────────────────── */

  .ai-split-lede {
    margin: 0 0 var(--s-3);
    color: var(--ink);
    font-weight: 500;
  }

  .split-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-4);
    margin: var(--s-5) 0;
  }

  .split-card {
    border: 1px solid var(--rule);
    background: var(--paper-2);
    padding: var(--s-4);
  }

  .split-card--decider {
    border-left: 2px solid var(--signal);
  }

  .ai-split .split-card-label {
    margin: 0 0 var(--s-3);
    color: var(--ink);
  }

  .split-card--decider .split-card-label {
    color: var(--signal);
  }

  .ai-split .split-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ai-split .split-list li {
    padding: var(--s-2) 0;
    border-top: 1px solid var(--rule);
    border-bottom: none;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .ai-split .split-list li:first-child {
    padding-top: 0;
    border-top: none;
  }

  .ai-split .split-list li:last-child {
    padding-bottom: 0;
  }

  .ai-stats {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    margin: var(--s-5) 0 0;
  }

  .ai-stat-card {
    border: 1px solid var(--rule);
    padding: var(--s-4);
    background: var(--paper);
  }

  .ai-stat-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-4);
    margin: 0 0 var(--s-3);
  }

  .ai-split .ai-stat-title {
    margin: 0;
    color: var(--ink);
  }

  .ai-split .ai-stat-value {
    margin: 0;
    font-size: 14px;
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0.02em;
    color: var(--ink);
  }

  .ai-split .ai-stat-value--shipped {
    color: var(--moss);
  }

  .ai-split .ai-stat-value--returned {
    color: var(--signal);
  }

  .ai-meter-svg {
    display: block;
    width: 100%;
    height: 8px;
    margin: 0 0 var(--s-2);
    border: 1px solid var(--rule);
    background: var(--paper-2);
  }

  .ai-meter-shipped {
    fill: var(--moss);
  }

  .ai-meter-returned,
  .ai-meter-signal {
    fill: var(--signal);
  }

  .ai-meter-untagged {
    fill: var(--rule);
  }

  .ai-split .ai-meter-caption {
    margin: 0 0 var(--s-3);
    color: var(--ink-soft);
    text-transform: none;
    letter-spacing: 0.01em;
    line-height: 1.5;
  }

  .ai-split .ai-stat-meta {
    margin: 0;
    padding-top: var(--s-3);
    border-top: 1px solid var(--rule);
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .ai-split .ai-stat-meta strong {
    color: var(--ink);
    font-weight: 500;
  }

  /* ─── Build log — the lead section: this site's own commits ─────────── */

  .build-log-lede {
    margin: 0 0 var(--s-4);
    color: var(--ink-soft);
  }

  /* Quiet provenance line closing the build log — recedes to meta weight. */
  .build-log-note {
    margin: var(--s-4) 0 0;
    color: var(--ink-soft);
    max-width: 62ch;
    line-height: 1.5;
    text-transform: none;
    letter-spacing: 0.01em;
  }

  /* Featured latest commit — the most recent ship, enlarged and accent-marked
     so recency reads at a glance. Its "shipped N days ago" is build-time. */
  .commit-featured {
    border: 1px solid var(--rule);
    border-left: 2px solid var(--signal);
    padding: var(--s-4);
    margin: 0 0 var(--s-5);
  }

  .commit-featured-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-3);
    margin: 0 0 var(--s-2);
  }

  .commit-featured .commit-sha {
    margin: 0;
    color: var(--moss);
    letter-spacing: 0.04em;
    font-size: 12px;
  }

  /* Compound selector beats `.colophon .t-mono` (0,2,0) so the reset actually
     wins — a bare `.commit-when` (0,1,0) leaves a stray bottom margin on the
     featured row's <time>, padding the space before the subject. */
  .commit-featured .commit-when {
    margin: 0;
    color: var(--ink-soft);
    font-size: 12px;
    white-space: nowrap;
  }

  .commit-featured-subject {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  /* Earlier commits — a bigger, breathier list than the old 12px grid. */
  .build-log .commit-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--rule);
  }

  .build-log .commit {
    display: grid;
    grid-template-columns: 76px 1fr auto;
    gap: var(--s-4);
    align-items: baseline;
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
    font-size: 13px;
    line-height: 1.5;
  }

  /* Override the 11px .t-mono pin so the promoted list actually reads larger. */
  .build-log .commit-sha {
    margin: 0;
    color: var(--moss);
    letter-spacing: 0.04em;
    font-size: 13px;
  }

  .build-log .commit-subject {
    margin: 0;
    color: var(--ink-soft);
    overflow-wrap: anywhere;
    font-size: 13px;
  }

  .build-log .commit-date {
    margin: 0;
    color: var(--ink-soft);
    font-size: 12px;
    white-space: nowrap;
  }

  @media (max-width: 680px) {
    .split-grid {
      grid-template-columns: 1fr;
    }
    .build-log .commit {
      grid-template-columns: 68px 1fr;
    }
    .build-log .commit-date {
      grid-column: 1 / -1;
    }
  }
</style>
