---
import { existsSync, readFileSync } from "node:fs";
import { resolve } from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import type { ColophonStatsData } from "../lib/colophon-stats";
import {
  formatHumanDate,
  formatHumanDateRange,
  isValidColophonStats,
  meterSegments,
} from "../lib/colophon-stats";
import { serializeJsonLd } from "../lib/json-ld";

const trailRegisterRoot = resolve(process.cwd(), "src/content/trail-register");

interface CommitEntry {
  sha: string;
  shortSha: string;
  subject: string;
  author: string;
  date: string;
}

// The prebuild hook (`scripts/gen-trail-register.ts`) writes commits.json from
// `git log`. The seed file is the committed fallback for shallow Vercel clones
// that don't run the hook.
// Only prefer the gitignored live file in a production build — same guard as
// the shift-log's loadContributions (src/pages/index.astro). Under Playwright
// (`pnpm dev`, whose predev regenerates commits.json) the live log changes
// with EVERY commit, which made the colophon's visual baselines stale the
// moment anything landed. The committed seed keeps screenshots deterministic.
function loadCommits(): CommitEntry[] {
  const candidates = import.meta.env.PROD
    ? ["commits.json", "commits.seed.json"]
    : ["commits.seed.json"];
  for (const name of candidates) {
    const file = resolve(trailRegisterRoot, name);
    if (!existsSync(file)) continue;
    try {
      const raw = JSON.parse(readFileSync(file, "utf8"));
      if (Array.isArray(raw) && raw.length > 0) {
        return raw as CommitEntry[];
      }
    } catch {
      // fall through to the next candidate
    }
  }
  return [];
}

function loadColophonStats(): ColophonStatsData | null {
  const candidates = import.meta.env.PROD
    ? ["stats.json", "stats.seed.json"]
    : ["stats.seed.json"];
  for (const name of candidates) {
    const file = resolve(trailRegisterRoot, name);
    if (!existsSync(file)) continue;
    try {
      const raw: unknown = JSON.parse(readFileSync(file, "utf8"));
      if (isValidColophonStats(raw)) {
        return raw;
      }
    } catch {
      // fall through to the next candidate
    }
  }
  return null;
}

function formatCommitDate(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso;
  const yyyy = d.getFullYear();
  const mm = String(d.getMonth() + 1).padStart(2, "0");
  const dd = String(d.getDate()).padStart(2, "0");
  return `${yyyy}.${mm}.${dd}`;
}

function statsSource(metric: {
  source: "live" | "seed";
  asOf: string;
}): string {
  return `${metric.source === "live" ? "Live" : "Snapshot"} as of ${formatHumanDate(metric.asOf)}`;
}

// Human-relative age for the featured commit — "shipped today / yesterday /
// N days ago". Computed at build time (the page rebuilds on every push), so
// it is accurate as of each deploy without any client JS.
function relativeTime(iso: string): string {
  const then = new Date(iso).getTime();
  if (Number.isNaN(then)) return "";
  const days = Math.floor((Date.now() - then) / 86_400_000);
  if (days <= 0) return "today";
  if (days === 1) return "yesterday";
  if (days < 7) return `${days} days ago`;
  const weeks = Math.floor(days / 7);
  if (weeks === 1) return "last week";
  if (days < 30) return `${weeks} weeks ago`;
  const months = Math.floor(days / 30);
  return months === 1 ? "last month" : `${months} months ago`;
}

const commits = loadCommits().slice(0, 14);
const [featured, ...rest] = commits;
const stats = loadColophonStats();

const prMeter = stats
  ? meterSegments(
      stats.pullRequests.mergedCount,
      stats.pullRequests.closedUnmergedCount,
    )
  : null;
const modelMeter = stats
  ? meterSegments(
      stats.commits.modelTrailerCommits,
      stats.commits.totalCommits - stats.commits.modelTrailerCommits,
    )
  : null;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://korabeland.com/colophon",
  url: "https://korabeland.com/colophon",
  name: "korabeland.com: colophon",
  description: "How korabeland.com was built and the tools used.",
  isPartOf: { "@id": "https://korabeland.com/#website" },
};

const tools: { label: string; note: string }[] = [
  { label: "Astro 7", note: "page routing, server output via Vercel adapter" },
  {
    label: "Tailwind CSS 4",
    note: "CSS-first configuration; tokens in src/styles/tokens.css",
  },
  {
    label: "shadcn/ui + React 19",
    note: "interactive islands where they earn their weight",
  },
  { label: "Keystatic", note: "local-git-backed CMS for long-form posts" },
  { label: "Vercel", note: "hosting, preview deploys, edge functions" },
  {
    label: "firstmate + Claude, Codex, and Gemini agents",
    note: "the supervised agent crew building this site",
  },
];
---

<BaseLayout
  title="korabeland.com: colophon"
  description="How korabeland.com was built and the tools used."
  active="colophon"
>
  <script is:inline type="application/ld+json" slot="jsonld" set:html={serializeJsonLd(jsonLd)} />
  <article class="prose colophon">
    <header>
      <p class="t-label">§ · colophon</p>
      <h1>Colophon</h1>
      <p class="lede">
        A record of how this site was built. For who built it, see
        {" "}<a href="/about">about</a>.
      </p>
    </header>

    {stats && prMeter && modelMeter && (
      <section aria-labelledby="built-with-ai" class="ai-split">
        <h2 id="built-with-ai">Built with AI, decided by me</h2>
        <p>
          I do not hand-write the code for this site. A crew of AI coding
          agents builds it as a working product, while I set the direction,
          make the product and design calls, and approve every change before it
          goes live. No agent can merge to <code>main</code> on its own.
        </p>

        <figure class="ai-crew-diagram" aria-labelledby="ai-crew-caption">
          <figcaption id="ai-crew-caption" class="t-label">
            How a request moves through my agent crew, with a separate queue for lab work
          </figcaption>
          <picture class="ai-crew-diagram-day">
            <source media="(max-width: 680px)" type="image/avif" srcset="/diagrams/ai-crew-flow-day-mobile.gen.375.avif 375w, /diagrams/ai-crew-flow-day-mobile.gen.750.avif 750w" sizes="100vw" />
            <source media="(max-width: 680px)" type="image/webp" srcset="/diagrams/ai-crew-flow-day-mobile.gen.375.webp 375w, /diagrams/ai-crew-flow-day-mobile.gen.750.webp 750w" sizes="100vw" />
            <source type="image/avif" srcset="/diagrams/ai-crew-flow-day.gen.680.avif 680w, /diagrams/ai-crew-flow-day.gen.1360.avif 1360w" sizes="(max-width: 680px) 100vw, 680px" />
            <source type="image/webp" srcset="/diagrams/ai-crew-flow-day.gen.680.webp 680w, /diagrams/ai-crew-flow-day.gen.1360.webp 1360w" sizes="(max-width: 680px) 100vw, 680px" />
            <img src="/diagrams/ai-crew-flow-day.gen.680.webp" alt="Korab sends a plain-English request to his first mate, who routes web work to a site second mate and lab work to a separate muted queue. The site second mate sends a task brief to an isolated worker agent. Automated checks and a different model family review its pull request. Clear findings return to the worker for a fix. Product or design questions and a preview return to Korab, who approves the merge and deploy." width="2172" height="724" loading="eager" decoding="async" sizes="(max-width: 680px) 100vw, 680px" />
          </picture>
          <picture class="ai-crew-diagram-dark">
            <source media="(max-width: 680px)" type="image/avif" srcset="/diagrams/ai-crew-flow-dark-mobile.gen.375.avif 375w, /diagrams/ai-crew-flow-dark-mobile.gen.750.avif 750w" sizes="100vw" />
            <source media="(max-width: 680px)" type="image/webp" srcset="/diagrams/ai-crew-flow-dark-mobile.gen.375.webp 375w, /diagrams/ai-crew-flow-dark-mobile.gen.750.webp 750w" sizes="100vw" />
            <source type="image/avif" srcset="/diagrams/ai-crew-flow-dark.gen.680.avif 680w, /diagrams/ai-crew-flow-dark.gen.1360.avif 1360w" sizes="(max-width: 680px) 100vw, 680px" />
            <source type="image/webp" srcset="/diagrams/ai-crew-flow-dark.gen.680.webp 680w, /diagrams/ai-crew-flow-dark.gen.1360.webp 1360w" sizes="(max-width: 680px) 100vw, 680px" />
            <img src="/diagrams/ai-crew-flow-dark.gen.680.webp" alt="Korab sends a plain-English request to his first mate, who routes web work to a site second mate and lab work to a separate muted queue. The site second mate sends a task brief to an isolated worker agent. Automated checks and a different model family review its pull request. Clear findings return to the worker for a fix. Product or design questions and a preview return to Korab, who approves the merge and deploy." width="2172" height="724" loading="eager" decoding="async" sizes="(max-width: 680px) 100vw, 680px" />
          </picture>
        </figure>

        <p class="ai-diagram-intro">
          The crew runs on <a href="https://github.com/kunchenguid/firstmate">firstmate</a>,
          an open-source supervisor for coding agents created by Kun Chen. I use
          it and contribute fixes upstream. My single point of contact is a
          supervising agent I call my first mate, which sends all my web work to
          a dedicated site second mate that looks after this site and its
          companion repositories on their own queue. When I describe what I
          want in plain English, the supervisor turns it into a task brief and
          hands it to an isolated worker running Anthropic Claude, OpenAI
          ChatGPT (via Codex), or Google Gemini.
        </p>

        <p class="ai-diagram-intro">
          The site's architecture and security are built with intention, and
          the system catches mistakes automatically before I review a preview.
          Every change is built in an isolated copy of the repository, checked
          by an automated verification and security suite, and reviewed by a
          model from a different family, so an agent never grades its own work.
          Clear defects get fixed inside the pipeline. Ambiguous product or
          design questions come back to me. From March through September 2026 I
          shipped <strong>52</strong> pull requests in hands-on sessions, mostly
          in a single burst of <strong>47</strong> in July. In the first 25 days
          on Firstmate, in October, <strong>32</strong> were merged at a steady
          pace that takes very little of my own time.
        </p>

        <p class="ai-diagram-intro">
          I am not an engineer by education. After 13 years in marketing,
          customer experience, and operations, I built this site as a live
          example of my research into AI systems, and of how far you can go by
          pairing an advanced harness like Firstmate with three basic $20
          subscriptions across Claude, ChatGPT, and Gemini. The first mate sends
          each job to the model that suits the work and has spare allowance,
          which keeps costs down.
        </p>

        <p class="ai-diagram-intro">
          The agents write the code and run the checks. I stay on judgement,
          voice, and taste, and I remain accountable for every decision on the
          page.
        </p>

        <div class="ai-stats" role="group" aria-label="Repository numbers">
          <div class="ai-stat-card" data-stat="shipped">
            <div class="ai-stat-head">
              <span class="t-label ai-stat-title">changes shipped</span>
              <span class="t-mono ai-stat-value ai-stat-value--shipped">
                {stats.pullRequests.mergedCount} merged pull requests
              </span>
            </div>
            <svg
              class="ai-meter-svg"
              viewBox="0 0 1000 8"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <rect
                class="ai-meter-shipped"
                x="0"
                y="0"
                width={prMeter.primaryWidth}
                height="8"
              />
              <rect
                class="ai-meter-returned"
                x={prMeter.secondaryX}
                y="0"
                width={prMeter.secondaryWidth}
                height="8"
              />
            </svg>
            <p class="t-mono small ai-meter-caption">
              {stats.pullRequests.mergedCount} merged ({prMeter.primaryPercent}%) · {stats.pullRequests.closedUnmergedCount} closed unmerged · {stats.commits.totalCommits} commits on main
            </p>
            <p class="ai-stat-meta">
              <strong>Source:</strong> Pull request counts from public GitHub
              pull requests ({statsSource(stats.pullRequests)}); commit counts
              from commit history on <code>korabeland/korabeland.com</code> ({statsSource(stats.commits)}).
            </p>
          </div>

          <div class="ai-stat-card" data-stat="returned">
            <div class="ai-stat-head">
              <span class="t-label ai-stat-title">changes sent back</span>
              <span class="t-mono ai-stat-value ai-stat-value--returned">
                {stats.pullRequests.closedUnmergedCount} closed without merging
              </span>
            </div>
            <p class="t-mono small ai-meter-caption">
              {stats.commits.noMistakesRounds} automated pipeline fix rounds across {stats.commits.noMistakesCommits} merged pull requests ({formatHumanDateRange(stats.commits.recentRange)})
            </p>
            <p class="ai-stat-meta">
              <strong>Source:</strong> Closed pull request counts from public
              GitHub pull requests ({statsSource(stats.pullRequests)}); pipeline
              fix counts from commits in the public{" "}
              <code>korabeland/korabeland.com</code> repository ({statsSource(stats.commits)}).
            </p>
          </div>

          <div class="ai-stat-card" data-stat="models">
            <div class="ai-stat-head">
              <span class="t-label ai-stat-title">models used</span>
              <span class="t-mono ai-stat-value">
                {stats.commits.modelTrailerCommits} of {stats.commits.totalCommits} commits name a model in git
              </span>
            </div>
            <svg
              class="ai-meter-svg"
              viewBox="0 0 1000 8"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <rect
                class="ai-meter-signal"
                x="0"
                y="0"
                width={modelMeter.primaryWidth}
                height="8"
              />
              <rect
                class="ai-meter-untagged"
                x={modelMeter.secondaryX}
                y="0"
                width={modelMeter.secondaryWidth}
                height="8"
              />
            </svg>
            <p class="t-mono small ai-meter-caption">
              {stats.commits.modelTrailerCommits} commits with a Claude trailer ({modelMeter.primaryPercent}%) · {stats.commits.unattributedRecentCommits} commits since {formatHumanDate(stats.commits.recentRange.startDate)} with no model tag in git
            </p>
            <p class="ai-stat-meta">
              <strong>Source:</strong> Counted from <code>Co-authored-by</code>
              commit trailers and review logs in{" "}
              <code>korabeland/korabeland.com</code> ({statsSource(stats.commits)}),
              noting that multi-model commits since October 2026 do not stamp a
              model tag into git.
            </p>
          </div>
        </div>
      </section>
    )}

    {commits.length > 0 && (
      <section aria-labelledby="build-log" class="build-log">
        <h2 id="build-log">Build log</h2>
        <p class="build-log-lede">Every change to this site, in the open.</p>

        {/* featured is always defined here: commits.length > 0 guarantees it */}
        <div class="commit-featured">
          <div class="commit-featured-top">
            <span class="commit-sha t-mono">{featured.shortSha}</span>
            <time class="commit-when t-mono" datetime={featured.date}>
              shipped {relativeTime(featured.date)}
            </time>
          </div>
          <p class="commit-featured-subject t-mono">{featured.subject}</p>
        </div>

        {rest.length > 0 && (
          <ol class="commit-list" aria-label="Earlier commits">
            {rest.map((commit) => (
              <li class="commit">
                <span class="commit-sha t-mono">{commit.shortSha}</span>
                <span class="commit-subject t-mono">{commit.subject}</span>
                <time class="commit-date t-mono" datetime={commit.date}>
                  {formatCommitDate(commit.date)}
                </time>
              </li>
            ))}
          </ol>
        )}

        {/* R14: the one visible confirmation that the portrait's glance is
            deliberate, for a visitor who noticed it. No hype, no em dash. */}
        <p class="t-mono small build-log-note">
          the hero portrait's gaze follows your cursor on purpose: a measured,
          test-covered rig that rests for reduced-motion and touch.
        </p>
      </section>
    )}

    <section aria-labelledby="stack">
      <h2 id="stack">Tools and stack</h2>
      <p>
        The site is small on purpose. The build pipeline does most of the
        work behind the scenes.
      </p>
      <ul>
        {tools.map((tool) => (
          <li>
            <strong>{tool.label}</strong>: {tool.note}
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="contact">
      <h2 id="contact">Get in touch</h2>
      <p>
        The fastest path is email:
        {" "}
        <a href="mailto:hello@korabeland.com">hello@korabeland.com</a>.
      </p>
      <p class="t-mono small">
        The outcome ledger on the home page will keep filling in as the work does.
      </p>
    </section>
  </article>
</BaseLayout>

<style>
  .colophon {
    max-width: var(--w-prose);
    margin-inline: auto;
    padding-block: var(--s-5) var(--s-8);
  }

  .colophon .t-mono {
    margin: 0 0 var(--s-3);
  }

  .colophon .lede {
    margin: 0 0 var(--s-5);
  }

  /* ─── Built with AI, decided by me ───────────────────────────────────── */

  .ai-diagram-intro {
    margin: 0 0 var(--s-4);
  }

  .ai-crew-diagram {
    margin: var(--s-4) 0 var(--s-5);
  }

  .ai-crew-diagram figcaption {
    margin: 0 0 var(--s-2);
    color: var(--ink-soft);
  }

  .ai-crew-diagram picture,
  .ai-crew-diagram img {
    display: block;
    width: 100%;
    height: auto;
  }

  .ai-crew-diagram img {
    aspect-ratio: 3 / 1;
  }

  @media (max-width: 680px) {
    .ai-crew-diagram img {
      aspect-ratio: 2 / 3;
    }
  }

  .ai-crew-diagram-dark {
    display: none !important;
  }

  :global(html[data-time="night"]) .ai-crew-diagram-day {
    display: none;
  }

  :global(html[data-time="night"]) .ai-crew-diagram-dark {
    display: block !important;
  }

  .ai-stats {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    margin: var(--s-5) 0 0;
  }

  .ai-stat-card {
    border: 1px solid var(--rule);
    padding: var(--s-4);
    background: var(--paper);
  }

  .ai-stat-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-4);
    margin: 0 0 var(--s-3);
  }

  .ai-split .ai-stat-title {
    margin: 0;
    color: var(--ink);
  }

  .ai-split .ai-stat-value {
    margin: 0;
    font-size: 14px;
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0.02em;
    color: var(--ink);
  }

  .ai-split .ai-stat-value--shipped {
    color: var(--moss);
  }

  .ai-split .ai-stat-value--returned {
    color: var(--signal);
  }

  .ai-meter-svg {
    display: block;
    width: 100%;
    height: 8px;
    margin: 0 0 var(--s-2);
    border: 1px solid var(--rule);
    background: var(--paper-2);
  }

  .ai-meter-shipped {
    fill: var(--moss);
  }

  .ai-meter-returned,
  .ai-meter-signal {
    fill: var(--signal);
  }

  .ai-meter-untagged {
    fill: var(--rule);
  }

  .ai-split .ai-meter-caption {
    margin: 0 0 var(--s-3);
    color: var(--ink-soft);
    text-transform: none;
    letter-spacing: 0.01em;
    line-height: 1.5;
  }

  .ai-split .ai-stat-meta {
    margin: 0;
    padding-top: var(--s-3);
    border-top: 1px solid var(--rule);
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .ai-split .ai-stat-meta strong {
    color: var(--ink);
    font-weight: 500;
  }

  /* ─── Build log — the lead section: this site's own commits ─────────── */

  .build-log-lede {
    margin: 0 0 var(--s-4);
    color: var(--ink-soft);
  }

  /* Quiet provenance line closing the build log — recedes to meta weight. */
  .build-log-note {
    margin: var(--s-4) 0 0;
    color: var(--ink-soft);
    max-width: 62ch;
    line-height: 1.5;
    text-transform: none;
    letter-spacing: 0.01em;
  }

  /* Featured latest commit — the most recent ship, enlarged and accent-marked
     so recency reads at a glance. Its "shipped N days ago" is build-time. */
  .commit-featured {
    border: 1px solid var(--rule);
    border-left: 2px solid var(--signal);
    padding: var(--s-4);
    margin: 0 0 var(--s-5);
  }

  .commit-featured-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-3);
    margin: 0 0 var(--s-2);
  }

  .commit-featured .commit-sha {
    margin: 0;
    color: var(--moss);
    letter-spacing: 0.04em;
    font-size: 12px;
  }

  /* Compound selector beats `.colophon .t-mono` (0,2,0) so the reset actually
     wins — a bare `.commit-when` (0,1,0) leaves a stray bottom margin on the
     featured row's <time>, padding the space before the subject. */
  .commit-featured .commit-when {
    margin: 0;
    color: var(--ink-soft);
    font-size: 12px;
    white-space: nowrap;
  }

  .commit-featured-subject {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  /* Earlier commits — a bigger, breathier list than the old 12px grid. */
  .build-log .commit-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--rule);
  }

  .build-log .commit {
    display: grid;
    grid-template-columns: 76px 1fr auto;
    gap: var(--s-4);
    align-items: baseline;
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
    font-size: 13px;
    line-height: 1.5;
  }

  /* Override the 11px .t-mono pin so the promoted list actually reads larger. */
  .build-log .commit-sha {
    margin: 0;
    color: var(--moss);
    letter-spacing: 0.04em;
    font-size: 13px;
  }

  .build-log .commit-subject {
    margin: 0;
    color: var(--ink-soft);
    overflow-wrap: anywhere;
    font-size: 13px;
  }

  .build-log .commit-date {
    margin: 0;
    color: var(--ink-soft);
    font-size: 12px;
    white-space: nowrap;
  }

  @media (max-width: 680px) {
    .build-log .commit {
      grid-template-columns: 68px 1fr;
    }
    .build-log .commit-date {
      grid-column: 1 / -1;
    }
  }
</style>
