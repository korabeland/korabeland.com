---
import { existsSync, readFileSync } from "node:fs";
import { resolve } from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";

const trailRegisterRoot = resolve(process.cwd(), "src/content/trail-register");

interface CommitEntry {
  sha: string;
  shortSha: string;
  subject: string;
  author: string;
  date: string;
}

// The prebuild hook (`scripts/gen-trail-register.ts`) writes commits.json from
// `git log`. The seed file is the committed fallback for shallow Vercel clones
// that don't run the hook.
// Only prefer the gitignored live file in a production build — same guard as
// the shift-log's loadContributions (src/pages/index.astro). Under Playwright
// (`pnpm dev`, whose predev regenerates commits.json) the live log changes
// with EVERY commit, which made the colophon's visual baselines stale the
// moment anything landed. The committed seed keeps screenshots deterministic.
function loadCommits(): CommitEntry[] {
  const candidates = import.meta.env.PROD
    ? ["commits.json", "commits.seed.json"]
    : ["commits.seed.json"];
  for (const name of candidates) {
    const file = resolve(trailRegisterRoot, name);
    if (!existsSync(file)) continue;
    try {
      const raw = JSON.parse(readFileSync(file, "utf8"));
      if (Array.isArray(raw) && raw.length > 0) {
        return raw as CommitEntry[];
      }
    } catch {
      // fall through to the next candidate
    }
  }
  return [];
}

function formatCommitDate(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso;
  const yyyy = d.getFullYear();
  const mm = String(d.getMonth() + 1).padStart(2, "0");
  const dd = String(d.getDate()).padStart(2, "0");
  return `${yyyy}.${mm}.${dd}`;
}

// Human-relative age for the featured commit — "shipped today / yesterday /
// N days ago". Computed at build time (the page rebuilds on every push), so
// it is accurate as of each deploy without any client JS.
function relativeTime(iso: string): string {
  const then = new Date(iso).getTime();
  if (Number.isNaN(then)) return "";
  const days = Math.floor((Date.now() - then) / 86_400_000);
  if (days <= 0) return "today";
  if (days === 1) return "yesterday";
  if (days < 7) return `${days} days ago`;
  const weeks = Math.floor(days / 7);
  if (weeks === 1) return "last week";
  if (days < 30) return `${weeks} weeks ago`;
  const months = Math.floor(days / 30);
  return months === 1 ? "last month" : `${months} months ago`;
}

const commits = loadCommits().slice(0, 14);
const [featured, ...rest] = commits;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://korabeland.com/colophon",
  url: "https://korabeland.com/colophon",
  name: "korabeland.com: colophon",
  description: "How korabeland.com was built and the tools used.",
  isPartOf: { "@id": "https://korabeland.com/#website" },
};

const tools: { label: string; note: string }[] = [
  { label: "Astro 6", note: "page routing, server output via Vercel adapter" },
  {
    label: "Tailwind CSS 4",
    note: "CSS-first configuration; tokens in src/styles/tokens.css",
  },
  {
    label: "shadcn/ui + React 19",
    note: "interactive islands where they earn their weight",
  },
  { label: "Keystatic", note: "local-git-backed CMS for long-form posts" },
  { label: "Vercel", note: "hosting, preview deploys, edge functions" },
  {
    label: "Claude Code + a small team of subagents",
    note: "the build crew running this site",
  },
];
---

<BaseLayout
  title="korabeland.com: colophon"
  description="How korabeland.com was built and the tools used."
  active="colophon"
>
  <script type="application/ld+json" slot="jsonld" set:html={JSON.stringify(jsonLd)} />
  <article class="prose colophon">
    <header>
      <p class="t-mono">§ · colophon</p>
      <h1>Colophon</h1>
      <p class="lede">
        A record of how this site was built. For who built it, see
        {" "}<a href="/about">about</a>.
      </p>
    </header>

    {commits.length > 0 && (
      <section aria-labelledby="build-log" class="build-log">
        <h2 id="build-log">Build log</h2>
        <p class="build-log-lede">Every change to this site, in the open.</p>

        {/* featured is always defined here: commits.length > 0 guarantees it */}
        <div class="commit-featured">
          <div class="commit-featured-top">
            <span class="commit-sha t-mono">{featured.shortSha}</span>
            <time class="commit-when t-mono" datetime={featured.date}>
              shipped {relativeTime(featured.date)}
            </time>
          </div>
          <p class="commit-featured-subject t-mono">{featured.subject}</p>
        </div>

        {rest.length > 0 && (
          <ol class="commit-list" aria-label="Earlier commits">
            {rest.map((commit) => (
              <li class="commit">
                <span class="commit-sha t-mono">{commit.shortSha}</span>
                <span class="commit-subject t-mono">{commit.subject}</span>
                <time class="commit-date t-mono" datetime={commit.date}>
                  {formatCommitDate(commit.date)}
                </time>
              </li>
            ))}
          </ol>
        )}
      </section>
    )}

    <section aria-labelledby="stack">
      <h2 id="stack">Tools and stack</h2>
      <p>
        The site is small on purpose. The build pipeline does most of the
        work behind the scenes.
      </p>
      <ul>
        {tools.map((tool) => (
          <li>
            <strong>{tool.label}</strong>: {tool.note}
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="contact">
      <h2 id="contact">Get in touch</h2>
      <p>
        The fastest path is email:
        {" "}
        <a href="mailto:korabeland@gmail.com">korabeland@gmail.com</a>.
      </p>
      <p class="t-mono small">
        The outcome ledger on the home page will keep filling in as the work does.
      </p>
    </section>
  </article>
</BaseLayout>

<style>
  .colophon {
    max-width: 620px;
    margin-inline: auto;
    padding-block: var(--s-5) var(--s-8);
  }

  .colophon .t-mono {
    margin: 0 0 var(--s-3);
  }

  .colophon .lede {
    margin: 0 0 var(--s-5);
  }

  /* ─── Build log — the lead section: this site's own commits ─────────── */

  .build-log-lede {
    margin: 0 0 var(--s-4);
    color: var(--ink-soft);
  }

  /* Featured latest commit — the most recent ship, enlarged and accent-marked
     so recency reads at a glance. Its "shipped N days ago" is build-time. */
  .commit-featured {
    border: 1px solid var(--rule);
    border-left: 2px solid var(--signal);
    padding: var(--s-4);
    margin: 0 0 var(--s-5);
  }

  .commit-featured-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-3);
    margin: 0 0 var(--s-2);
  }

  .commit-featured .commit-sha {
    margin: 0;
    color: var(--moss);
    letter-spacing: 0.04em;
    font-size: 12px;
  }

  /* Compound selector beats `.colophon .t-mono` (0,2,0) so the reset actually
     wins — a bare `.commit-when` (0,1,0) leaves a stray bottom margin on the
     featured row's <time>, padding the space before the subject. */
  .commit-featured .commit-when {
    margin: 0;
    color: var(--ink-soft);
    font-size: 12px;
    white-space: nowrap;
  }

  .commit-featured-subject {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  /* Earlier commits — a bigger, breathier list than the old 12px grid. */
  .build-log .commit-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--rule);
  }

  .build-log .commit {
    display: grid;
    grid-template-columns: 76px 1fr auto;
    gap: var(--s-4);
    align-items: baseline;
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
    font-size: 13px;
    line-height: 1.5;
  }

  /* Override the 11px .t-mono pin so the promoted list actually reads larger. */
  .build-log .commit-sha {
    margin: 0;
    color: var(--moss);
    letter-spacing: 0.04em;
    font-size: 13px;
  }

  .build-log .commit-subject {
    margin: 0;
    color: var(--ink-soft);
    overflow-wrap: anywhere;
    font-size: 13px;
  }

  .build-log .commit-date {
    margin: 0;
    color: var(--ink-mute);
    font-size: 12px;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .build-log .commit {
      grid-template-columns: 68px 1fr;
    }
    .build-log .commit-date {
      grid-column: 1 / -1;
    }
  }
</style>
