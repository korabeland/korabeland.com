---
// /lab — AI code tinkering index. The side-category slice of the projects
// collection, rendered through the shared ProjectLedger (also used by /work
// and the homepage bands). A fully separate route so personal projects never
// interleave with professional case studies. See docs/plans/2026-07-03-console-mvp.md.

import ProjectLedger from "../../components/ProjectLedger/index.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { serializeJsonLd } from "../../lib/json-ld";
import { listProjects, projectHref, projectStatus } from "../../lib/projects";

const projects = (await listProjects()).filter((p) => p.category === "side");
const ledgerItems = projects.map((p) => ({
  slug: p.slug,
  title: p.title,
  outcome: p.outcome,
  status: projectStatus(p),
  href: projectHref(p),
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": "https://korabeland.com/lab",
  url: "https://korabeland.com/lab",
  name: "lab · AI code tinkering · korabeland.com",
  description:
    "Personal AI projects, built to learn how these systems behave, not to bill hours.",
  isPartOf: { "@id": "https://korabeland.com/#website" },
};
---

<BaseLayout
  title="lab · AI code tinkering · korab eland"
  description="Personal AI projects, built to learn how these systems behave, not to bill hours."
  active="lab"
>
  <script is:inline type="application/ld+json" slot="jsonld" set:html={serializeJsonLd(jsonLd)} />

  <div class="work">
    <section class="work-head">
      <h1 class="t-label work-eyebrow">lab · AI code tinkering</h1>
      <p class="work-intro">
        Personal projects, not client work. Built on my own time to learn how these
        systems behave, broken and rebuilt along the way.
      </p>
    </section>

    <ProjectLedger
      items={ledgerItems}
      headingText="all tinkering"
      emptyMessage="first tinkering project being written up."
    />
  </div>
</BaseLayout>

<style>
  .work {
    max-width: var(--w-shell);
    margin-inline: auto;
    padding: var(--s-7) var(--s-4) var(--s-8);
    display: flex;
    flex-direction: column;
    gap: var(--s-7);
  }

  .work-head {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .work-eyebrow {
    margin: 0;
  }

  .work-intro {
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 60ch;
    margin: 0;
  }

</style>
