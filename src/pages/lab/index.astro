---
// /lab — AI code tinkering index. Copy + the side slice of the projects
// collection; ProjectLedger renders the shared ledger grammar, kept as a
// fully separate route so personal projects never interleave with
// professional case studies.

import ProjectLedger from "../../components/ProjectLedger/ProjectLedger.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { listProjects } from "../../lib/projects";

const projects = (await listProjects()).filter((p) => p.category === "side");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": "https://korabeland.com/lab",
  url: "https://korabeland.com/lab",
  name: "lab · AI code tinkering · korabeland.com",
  description:
    "Personal AI projects, built to learn how these systems behave, not to bill hours.",
  isPartOf: { "@id": "https://korabeland.com/#website" },
};
---

<BaseLayout
  title="lab · AI code tinkering · korab eland"
  description="Personal AI projects, built to learn how these systems behave, not to bill hours."
  active="lab"
>
  <script type="application/ld+json" slot="jsonld" set:html={JSON.stringify(jsonLd)} />

  <ProjectLedger
    eyebrow="lab · AI code tinkering"
    intro="Personal projects, not client work. Built on my own time to learn how these systems behave, broken and rebuilt along the way."
    heading="all tinkering"
    emptyText="first tinkering project being written up."
    projects={projects}
  />
</BaseLayout>
