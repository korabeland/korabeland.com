---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { listPosts } from "../../lib/posts";

const posts = await listPosts();

function formatDate(iso: string | null): string {
  if (!iso) return "—";
  const d = new Date(iso);
  const pad = (n: number) => String(n).padStart(2, "0");
  return `${pad(d.getMonth() + 1)}.${pad(d.getDate())}.${String(d.getFullYear()).slice(-2)}`;
}

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": "https://korabeland.com/notes",
  url: "https://korabeland.com/notes",
  name: "field notes: korabeland.com",
  description: "Field notes on building, tools, and thinking in public.",
  isPartOf: { "@id": "https://korabeland.com/#website" },
  blogPost: posts.map((p) => ({
    "@type": "BlogPosting",
    headline: p.title,
    description: p.description,
    url: `https://korabeland.com/notes/${p.slug}`,
    datePublished: p.publishedAt,
  })),
};
---

<BaseLayout
  title="field notes: korabeland.com"
  description="Field notes on building, tools, and thinking in public."
  active="notes"
>
  <script type="application/ld+json" slot="jsonld" set:html={JSON.stringify(jsonLd)} />
  <section class="notes-head">
    <p class="t-label eyebrow">§ field notes</p>
    <h1 class="t-display title">Field notes.</h1>
    <p class="lede">
      A log of what I am thinking through: systems, tools, and the small
      bets behind them.
    </p>
  </section>

  <section class="notes-list">
    {posts.length === 0 ? (
      <p class="t-mono empty">no notes yet, check back soon.</p>
    ) : (
      <ul>
        {posts.map((p) => (
          <li class="row">
            <div class="row-meta t-mono">{formatDate(p.publishedAt)} · {p.readTime}</div>
            <a class="row-main" href={`/notes/${p.slug}`}>
              <h2 class="row-title">{p.title}</h2>
              {p.description && <p class="row-desc">{p.description}</p>}
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>

<style>
  .notes-head {
    max-width: 820px;
    margin: var(--s-7) auto var(--s-6);
  }
  .eyebrow {
    margin: 0 0 var(--s-4);
  }
  .title {
    font-size: clamp(28px, 4vw, 40px);
    margin: 0 0 var(--s-5);
  }
  .lede {
    font-family: var(--font-body);
    font-style: normal;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0;
    max-width: 52ch;
  }

  .notes-list {
    max-width: 820px;
    margin: var(--s-6) auto var(--s-9);
  }
  .notes-list ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .row {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: var(--s-5);
    padding: var(--s-5) 0;
    border-bottom: 1px solid var(--rule);
    align-items: baseline;
  }
  .row-meta {
    color: var(--ink-soft);
  }
  .row-main {
    color: inherit;
    text-decoration: none;
  }
  .row-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    margin: 0 0 6px;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .row-desc {
    font-size: 15px;
    color: var(--ink-soft);
    margin: 0;
  }
  .row-main:hover .row-title,
  .row-main:focus-visible .row-title {
    border-bottom: 1px solid var(--signal);
    display: inline;
  }
  .empty {
    color: var(--ink-soft);
  }
  @media (max-width: 640px) {
    .row {
      grid-template-columns: 1fr;
      gap: var(--s-2);
    }
  }
</style>
