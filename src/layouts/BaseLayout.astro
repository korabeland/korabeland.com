---
// BaseLayout.astro — page shell for every route.
//
// The Operator's Console (DESIGN.md 2026-07-03): the chrome is a clean
// rail — wordmark + mono nav labels, plus a small portrait badge on
// interior pages (the "logged-in operator").

import ShiftToggle from "../components/ShiftToggle/ShiftToggle.astro";
import "../styles/global.css";
// Critical font files, preloaded so first paint already has them (CLS).
import mono400 from "@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url";
import grotesk400 from "@fontsource/schibsted-grotesk/files/schibsted-grotesk-latin-400-normal.woff2?url";
import grotesk700 from "@fontsource/schibsted-grotesk/files/schibsted-grotesk-latin-700-normal.woff2?url";

interface Props {
  title: string;
  description?: string;
  /** Which nav item, if any, is "active" — controls the amber underline. */
  active?:
    | "home"
    | "notes"
    | "projects"
    | "work"
    | "lab"
    | "about"
    | "colophon";
  /** Absolute path to the OG image (e.g. "/og.png"). */
  ogImage?: string;
  /** og:type value — defaults to "website". */
  ogType?: string;
  /** Suppress indexing for utility/preview routes. */
  noindex?: boolean;
  /** Render <main> edge-to-edge with no max-width or padding. Used by the
   *  home kiosk, which manages its own internal containers. */
  fullBleed?: boolean;
  /** Suppress the site-wide footer. Used on the home page, which renders
   *  its own "thanks for wandering through" strip in place of the default. */
  hideFooter?: boolean;
}

const {
  title,
  description = "Korab Eland, operator. I turn ambiguous problems into systems that ship.",
  active,
  ogImage,
  ogType = "website",
  noindex,
  fullBleed = false,
  hideFooter = false,
} = Astro.props;

const siteUrl = Astro.site?.href.replace(/\/$/, "") ?? "https://korabeland.com";
const ogImageUrl = ogImage ? `${siteUrl}${ogImage}` : undefined;
// Prerendered directory-style routes (page/index.html) carry a trailing
// slash in Astro.url; every other reference to a page on this site (nav,
// redirects, sitemap) omits it, so strip it here to keep canonical/og:url
// consistent with the rest of the site. The bare root "/" still resolves
// correctly since URL.pathname normalises an empty path back to "/".
const canonicalUrl = Astro.url.href.replace(/\/$/, "");

const year = new Date().getFullYear();

interface NavLink {
  key: NonNullable<Props["active"]>;
  href: string;
  label: string;
  ariaLabel?: string;
}

const NAV_LINKS: readonly NavLink[] = [
  { key: "work", href: "/work", label: "work" },
  { key: "lab", href: "/lab", label: "lab" },
  {
    key: "notes",
    href: "/notes",
    label: "notes",
    ariaLabel: "field notes",
  },
  { key: "about", href: "/about", label: "about" },
  { key: "colophon", href: "/colophon", label: "colophon" },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- theme-color must precede the shift script below: the script rewrites it
         on day resolution, so the element has to already exist in the DOM when
         the script runs. Default is night; the script swaps it to the day
         value when the resolved shift is day. -->
    <meta name="theme-color" content="#16181c" />
    <!-- Pre-paint shift resolution (R7) — must run before any stylesheet
         applies so there is no flash of the wrong palette. Astro injects the
         global.css link into <head> regardless of import position, so the
         only reliable guarantee is source order: this inline, render-blocking
         script is the first node in <head>, ahead of every other tag.
         Precedence mirrors src/lib/shift.ts `resolveShift` exactly (that
         module is what Vitest exercises; this copy can't import it — an
         is:inline head script can't pull in a module graph and stay
         render-blocking). Any failure (storage blocked, private mode, etc.)
         falls back to night. The two copies are kept in lockstep by
         tests/shift-parity.test.ts, the enforced drift guard — it reads this
         file, evaluates the script body between the markers below in a
         node:vm sandbox, and asserts it matches resolveShift() across the
         full precedence truth table. -->
    <!-- SHIFT-RESOLVE:START — extraction anchor for tests/shift-parity.test.ts,
         which reads this file at test time and evaluates the script body
         between these markers in a node:vm sandbox. Keep the markers
         immediately wrapping the <script> tag if this block ever moves. -->
    <script is:inline>
      (function () {
        var SHIFT_KEY = "korab-shift";
        var SESSION_KEY = "korab-shift-session";
        var NIGHT_COLOR = "#16181c";
        var DAY_COLOR = "#f2f1ea";

        function isValidShift(v) {
          return v === "day" || v === "night";
        }
        function shiftFromHour(hour) {
          return hour >= 7 && hour <= 18 ? "day" : "night";
        }
        function applyTheme(shift) {
          document.documentElement.dataset.time = shift;
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) {
            meta.setAttribute("content", shift === "day" ? DAY_COLOR : NIGHT_COLOR);
          }
        }

        try {
          var params = new URLSearchParams(location.search);
          var query = params.get("shift");
          var stored = null;
          var sessionDefault = null;
          try {
            stored = localStorage.getItem(SHIFT_KEY);
          } catch (e) {
            stored = null;
          }
          try {
            sessionDefault = sessionStorage.getItem(SESSION_KEY);
          } catch (e) {
            sessionDefault = null;
          }

          var shift;
          if (isValidShift(query)) {
            shift = query;
          } else if (isValidShift(stored)) {
            shift = stored;
          } else if (isValidShift(sessionDefault)) {
            shift = sessionDefault;
          } else {
            shift = shiftFromHour(new Date().getHours());
            try {
              sessionStorage.setItem(SESSION_KEY, shift);
            } catch (e) {
              // Session persistence is best-effort; the resolved shift for
              // this view is unaffected.
            }
          }

          applyTheme(shift);
        } catch (e) {
          applyTheme("night");
        }
      })();
    </script>
    <!-- SHIFT-RESOLVE:END -->
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />
    <!-- Tab + iOS icons: static PNGs derived from the illustrated portrait
         (public/*.png). Kept out of the astro:assets pipeline on purpose —
         with `imageService: true` the Vercel optimizer ignores the forced
         `format: png` and serves webp, which browsers reject as an icon.
         Regenerate from src/assets/portrait-illustrated.jpg if it changes:
           sharp(src).resize(32,32).png()  →  public/favicon-32.png
           sharp(src).resize(180,180).png() →  public/apple-touch-icon-180.png -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-180.png" />
    <!-- Fonts are self-hosted; preload the critical weights so they land
         before first paint (no swap, no layout shift). -->
    <link rel="preload" href={grotesk400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={grotesk700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={mono400} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="korabeland.com" />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && <meta property="og:image:height" content="630" />}
    <!-- Twitter Card -->
    <meta name="twitter:card" content={ogImageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    <slot name="jsonld" />
    <!-- Per-page head extensions (e.g. the home page preloads its LCP
         image). Keep after the meta block so pages can't shadow it. -->
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">skip to content</a>
    <header class="chrome">
      <div class="chrome-inner">
        <div class="chrome-left">
          <ShiftToggle />
          <a class="chrome-brand" href="/" aria-label="Korab Eland, home">
            <span class="chrome-brand-text">korab eland</span>
          </a>
        </div>

        <div class="chrome-nav-row">
          <nav class="chrome-nav" aria-label="Primary">
            <ul>
              {NAV_LINKS.map((link) => (
                <li>
                  <a
                    href={link.href}
                    aria-label={link.ariaLabel}
                    aria-current={active === link.key ? "page" : undefined}
                    class={active === link.key ? "is-active" : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <a class="chrome-cta" href="mailto:hello@korabeland.com">get in touch</a>
        </div>

      </div>
    </header>

    <main id="main" class:list={["page-main", { "page-main--full-bleed": fullBleed }]}>
      <slot />
    </main>

    {!hideFooter && (
      <footer class="site-footer">
        <div class="site-footer-inner">
          <span class="site-footer-brand">korab eland</span>
          <span class="t-mono site-footer-links">
            <a href="mailto:hello@korabeland.com">email</a> ·{" "}
            <a href="https://www.linkedin.com/in/korabeland" rel="me">linkedin</a> ·{" "}
            <a href="/colophon">colophon</a> · © {year}
          </span>
        </div>
      </footer>
    )}
  </body>
</html>

<style>
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .skip-link {
    position: absolute;
    left: var(--s-4);
    top: var(--s-4);
    background: var(--paper);
    color: var(--ink);
    padding: 6px 12px;
    border: 1px solid var(--ink);
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    transform: translateY(-200%);
    transition: transform 200ms ease;
    z-index: 50;
  }
  .skip-link:focus-visible {
    transform: translateY(0);
  }

  .chrome {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }

  .chrome-inner {
    max-width: 1280px;
    margin-inline: auto;
    padding: var(--s-4) var(--s-6);
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--s-5);
  }

  .chrome-left {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .chrome-brand {
    display: inline-flex;
    align-items: center;
    color: var(--ink);
    text-decoration: none;
  }

  .chrome-brand-text {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 18px;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .chrome-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: flex-end;
    gap: var(--s-6);
  }

  .chrome-nav a {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    text-decoration: none;
    padding-bottom: 3px;
    border-bottom: 1px solid transparent;
    transition: color 200ms ease, border-color 200ms ease;
  }

  .chrome-nav a:hover,
  .chrome-nav a:focus-visible {
    color: var(--ink);
  }

  .chrome-nav a.is-active {
    color: var(--ink);
    border-bottom-color: var(--signal);
  }

  .chrome-nav-row {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--s-5);
  }

  /* Primary contact CTA — the one signal-filled control in the chrome. It
     carries --paper as its text (paper flips with the shift, so it stays the
     correct inverse of --signal in both day and night). Hover hollows it out. */
  .chrome-cta {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    padding: 9px 15px;
    background: var(--signal);
    color: var(--paper);
    border: 1px solid var(--signal);
    text-decoration: none;
    transition:
      background 200ms ease,
      color 200ms ease;
  }

  .chrome-cta:hover,
  .chrome-cta:focus-visible {
    background: transparent;
    color: var(--signal);
  }

  .page-main {
    flex: 1;
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding: var(--s-6) var(--s-4);
  }

  /* Full-bleed mode: page owns its own containers and bleeds to the viewport
     edge. Used by the home kiosk. Vertical padding drops too so the hero
     sits flush under the sticky chrome. */
  .page-main--full-bleed {
    max-width: none;
    padding: 0;
    margin-inline: 0;
  }

  .site-footer {
    border-top: 1px solid var(--rule);
    padding: var(--s-6) var(--s-4);
    margin-top: var(--s-8);
  }

  .site-footer-inner {
    max-width: 1280px;
    margin-inline: auto;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-3);
    flex-wrap: wrap;
  }

  .site-footer-brand {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 16px;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .site-footer a {
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 200ms ease, color 200ms ease;
  }
  .site-footer a:hover,
  .site-footer a:focus-visible {
    color: var(--ink);
    border-bottom-color: var(--signal);
  }

  @media (max-width: 640px) {
    .chrome-inner {
      grid-template-columns: 1fr;
      row-gap: var(--s-3);
    }
    .chrome-nav-row {
      flex-wrap: wrap;
      justify-content: flex-start;
      gap: var(--s-3);
    }
    /* Nav takes the full first line so no label is clipped; the toggle wraps
       to its own line below rather than squeezing the nav. */
    .chrome-nav {
      flex: 1 1 100%;
      overflow-x: auto;
      /* overflow-x forces overflow-y to auto, which would clip the 44px
         hit-area pads (global.css) at the scroll box. Padding gives the
         pads room inside the clip box; the negative margin cancels the
         layout shift, so nothing moves visually. */
      padding-block: 14px;
      margin-block: -14px;
    }
    .chrome-nav ul {
      justify-content: flex-start;
      gap: var(--s-4);
    }
  }
</style>
