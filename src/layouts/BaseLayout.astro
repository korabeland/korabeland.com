---
// BaseLayout.astro — page shell for every route.
//
// The Operator's Console (DESIGN.md 2026-07-03): the chrome is a clean
// rail — wordmark + mono nav labels, plus a small portrait badge on
// interior pages (the "logged-in operator"). The availability signal
// lives in the homepage hero readout; every footer carries a quiet echo.

import { Image } from "astro:assets";
import "../styles/global.css";
// Critical font files, preloaded so first paint already has them (CLS).
import mono400 from "@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url";
import grotesk400 from "@fontsource/schibsted-grotesk/files/schibsted-grotesk-latin-400-normal.woff2?url";
import grotesk700 from "@fontsource/schibsted-grotesk/files/schibsted-grotesk-latin-700-normal.woff2?url";
import portrait from "../assets/portrait-illustrated.jpg";

interface Props {
  title: string;
  description?: string;
  /** Which nav item, if any, is "active" — controls the amber underline. */
  active?: "home" | "notes" | "projects" | "work" | "about" | "colophon";
  /** Absolute path to the OG image (e.g. "/og.png"). */
  ogImage?: string;
  /** og:type value — defaults to "website". */
  ogType?: string;
  /** Suppress indexing for utility/preview routes. */
  noindex?: boolean;
  /** Render <main> edge-to-edge with no max-width or padding. Used by the
   *  home kiosk, which manages its own internal containers. */
  fullBleed?: boolean;
  /** Suppress the site-wide footer. Used on the home page, which renders
   *  its own "thanks for wandering through" strip in place of the default. */
  hideFooter?: boolean;
}

const {
  title,
  description = "Korab Eland, operator. I turn ambiguous problems into systems that ship.",
  active,
  ogImage,
  ogType = "website",
  noindex,
  fullBleed = false,
  hideFooter = false,
} = Astro.props;

// Interior pages get the small portrait badge in the rail; the homepage
// carries the full framed portrait in its hero instead.
const showBadge = active !== "home";

const siteUrl = Astro.site?.href.replace(/\/$/, "") ?? "https://korabeland.com";
const ogImageUrl = ogImage ? `${siteUrl}${ogImage}` : undefined;

const year = new Date().getFullYear();

interface NavLink {
  key: NonNullable<Props["active"]>;
  href: string;
  label: string;
  ariaLabel?: string;
}

const NAV_LINKS: readonly NavLink[] = [
  { key: "work", href: "/work", label: "work" },
  {
    key: "notes",
    href: "/notes",
    label: "notes",
    ariaLabel: "field notes",
  },
  { key: "about", href: "/about", label: "about" },
  { key: "colophon", href: "/colophon", label: "colophon" },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#16181c" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={Astro.url.href} />
    <!-- Fonts are self-hosted; preload the critical weights so they land
         before first paint (no swap, no layout shift). -->
    <link rel="preload" href={grotesk400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={grotesk700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={mono400} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:site_name" content="korabeland.com" />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && <meta property="og:image:height" content="630" />}
    <!-- Twitter Card -->
    <meta name="twitter:card" content={ogImageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    <slot name="jsonld" />
  </head>
  <body>
    <a class="skip-link" href="#main">skip to content</a>
    <header class="chrome">
      <div class="chrome-inner">
        <a class="chrome-brand" href="/" aria-label="Korab Eland, home">
          {showBadge ? (
            <Image
              class="chrome-badge"
              src={portrait}
              alt=""
              width={52}
              height={52}
              loading="eager"
            />
          ) : (
            <svg class="chrome-mark" viewBox="0 0 18 18" aria-hidden="true">
              <rect x="1.5" y="1.5" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1" />
              <circle cx="9" cy="9" r="2.4" fill="currentColor" />
            </svg>
          )}
          <span class="chrome-brand-text">korab eland</span>
        </a>

        <nav class="chrome-nav" aria-label="Primary">
          <ul>
            {NAV_LINKS.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-label={link.ariaLabel}
                  aria-current={active === link.key ? "page" : undefined}
                  class={active === link.key ? "is-active" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

      </div>
    </header>

    <main id="main" class:list={["page-main", { "page-main--full-bleed": fullBleed }]}>
      <slot />
    </main>

    {!hideFooter && (
      <footer class="site-footer">
        <div class="site-footer-inner">
          <span class="site-footer-brand">korab eland</span>
          <span class="t-mono site-footer-links">
            <span class="footer-avail">● open to roles</span> ·{" "}
            <a href="mailto:korabeland@gmail.com">email</a> ·{" "}
            <a href="https://www.linkedin.com/in/korabeland" rel="me">linkedin</a> ·{" "}
            <a href="/colophon">colophon</a> · © {year}
          </span>
        </div>
      </footer>
    )}
  </body>
</html>

<style>
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .skip-link {
    position: absolute;
    left: var(--s-4);
    top: var(--s-4);
    background: var(--paper);
    color: var(--ink);
    padding: 6px 12px;
    border: 1px solid var(--ink);
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    transform: translateY(-200%);
    transition: transform 200ms ease;
    z-index: 50;
  }
  .skip-link:focus-visible {
    transform: translateY(0);
  }

  .chrome {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
    backdrop-filter: blur(8px);
  }

  .chrome-inner {
    max-width: 1280px;
    margin-inline: auto;
    padding: var(--s-4) var(--s-6);
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--s-5);
  }

  .chrome-brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--ink);
    text-decoration: none;
  }

  .chrome-mark {
    width: 18px;
    height: 18px;
    color: var(--ink);
  }

  .chrome-badge {
    width: 26px;
    height: 26px;
    border-radius: var(--r-1);
    border: 1px solid var(--rule);
    object-fit: cover;
    display: block;
  }

  .chrome-brand-text {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 18px;
    letter-spacing: -0.01em;
  }

  .chrome-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: flex-end;
    gap: var(--s-6);
  }

  .chrome-nav a {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    text-decoration: none;
    padding-bottom: 3px;
    border-bottom: 1px solid transparent;
    transition: color 200ms ease, border-color 200ms ease;
  }

  .chrome-nav a:hover,
  .chrome-nav a:focus-visible {
    color: var(--ink);
  }

  .chrome-nav a.is-active {
    color: var(--ink);
    border-bottom-color: var(--amber);
  }

  .page-main {
    flex: 1;
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding: var(--s-6) var(--s-4);
  }

  /* Full-bleed mode: page owns its own containers and bleeds to the viewport
     edge. Used by the home kiosk. Vertical padding drops too so the hero
     sits flush under the sticky chrome. */
  .page-main--full-bleed {
    max-width: none;
    padding: 0;
    margin-inline: 0;
  }

  .site-footer {
    border-top: 1px solid var(--rule);
    padding: var(--s-6) var(--s-4);
    margin-top: var(--s-8);
  }

  .site-footer-inner {
    max-width: 1280px;
    margin-inline: auto;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-3);
    flex-wrap: wrap;
  }

  .site-footer-brand {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 16px;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .site-footer a {
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 200ms ease, color 200ms ease;
  }
  .site-footer a:hover,
  .site-footer a:focus-visible {
    color: var(--ink);
    border-bottom-color: var(--amber);
  }

  .footer-avail {
    color: var(--amber);
    letter-spacing: 0.06em;
  }

  @media (max-width: 640px) {
    .chrome-inner {
      grid-template-columns: 1fr;
      row-gap: var(--s-3);
    }
    .chrome-nav {
      overflow-x: auto;
    }
    .chrome-nav ul {
      justify-content: flex-start;
      gap: var(--s-4);
    }
  }
</style>
