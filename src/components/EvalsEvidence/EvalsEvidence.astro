---
import { evalsDefects, evalsScorecard } from "../../lib/evals-evidence";
---

<div class="evidence">
  <section aria-labelledby="scorecard-heading">
    <h2 id="scorecard-heading" class="t-label">sample scorecard</h2>
    <p>
      {evalsScorecard.intro}
    </p>
    <div class="table-scroll" tabindex="0" aria-label="Sample scorecard table">
      <table>
        <caption>Observed results for software building tasks</caption>
        <thead>
          <tr>
            <th scope="col">Model</th>
            <th scope="col">Agent setup</th>
            <th scope="col">Task group</th>
            <th scope="col">Attempts</th>
            <th scope="col">Pass rate</th>
          </tr>
        </thead>
        <tbody>
          {evalsScorecard.rows.map((row) => (
            <tr>
              <th scope="row"><code>{row.model}</code></th>
              <td>{row.setup}</td>
              <td>{row.taskGroup}</td>
              <td class="number">{row.attempts}</td>
              <td class="number">{row.passRate}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="table-hint">Scroll sideways to view all columns.</p>
    <p class="limit">
      {evalsScorecard.limit}
    </p>
  </section>

  <section aria-labelledby="defects-heading">
    <h2 id="defects-heading" class="t-label">defects the suite exposed</h2>
    <ol class="defects">
      {evalsDefects.map((defect) => (
        <li>
          <h3>{defect.title}</h3>
          <p>{defect.summary}</p>
          <p class="source">Source: <code>{defect.source}</code></p>
        </li>
      ))}
    </ol>
  </section>

</div>

<style>
  .evidence {
    display: grid;
    gap: var(--s-7);
    margin-top: var(--s-7);
  }

  .evidence > section {
    min-width: 0;
  }

  h2 {
    margin: 0 0 var(--s-4);
    padding-bottom: var(--s-2);
    border-bottom: 1px solid var(--ink);
  }

  p {
    margin: 0 0 var(--s-4);
    color: var(--ink-soft);
    line-height: 1.65;
  }

  .table-scroll {
    width: 100%;
    min-width: 0;
    overflow-x: auto;
    border-block: 1px solid var(--rule);
    scrollbar-color: var(--rule) var(--paper);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 14px;
  }

  caption {
    padding: var(--s-3) 0;
    color: var(--ink-soft);
    text-align: left;
    font-size: 13px;
  }

  th,
  td {
    padding: var(--s-3) var(--s-2);
    border-top: 1px solid var(--rule);
    vertical-align: top;
  }

  thead th {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 500;
  }

  tbody th {
    font-weight: 400;
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.92em;
    overflow-wrap: anywhere;
  }

  .number {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .limit {
    margin-top: var(--s-3);
  }

  .table-hint {
    display: none;
  }

  .defects {
    display: grid;
    gap: var(--s-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .defects li {
    border-left: 2px solid var(--signal);
    padding-left: var(--s-4);
  }

  h3 {
    margin: 0 0 var(--s-2);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 500;
  }

  .source {
    margin-bottom: 0;
    font-size: 13px;
  }

  .reading p {
    margin-bottom: 0;
  }

  @media (max-width: 680px) {
    .table-hint {
      display: block;
      margin: var(--s-2) 0 var(--s-3);
      font-size: 12px;
    }

    table {
      min-width: 620px;
    }
  }
</style>
