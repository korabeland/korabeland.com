---
// ShiftLog — GitHub contribution grid in console grammar (R9).
//
// The accessible representation is the mono summary line, computed from the
// real data via src/lib/shift-log.ts (never hardcoded). The 52-53×7 cell
// grid is aria-hidden decoration layered on top of that — screen readers
// see only the summary and the staleness caption. Each cell gets an intensity
// class (0-4) mapped to signal strength via scoped CSS.
//
// The one script below is this component's first client JS — a cursor torch
// that blooms the busy days near the pointer. It is a deliberate exception to
// the zero-JS property: double-gated on a fine pointer AND motion allowed, so
// touch and reduced-motion visitors get the static framed grid untouched (R9).

import type { ContributionData } from "../../lib/shift-log";
import {
  levelToIntensity,
  monthTicks,
  summaryStats,
} from "../../lib/shift-log";

interface Props {
  data: ContributionData;
}

const { data } = Astro.props;

const stats = summaryStats(data);
const totalLabel = data.total.toLocaleString("en-US");
const sourceNote = data.source === "seed" ? " (seed)" : "";
const ticks = monthTicks(data);
// The legend reuses the cell swatches at their real intensities (0-4).
const legendLevels = [0, 1, 2, 3, 4] as const;
---

<div class="shiftlog">
  <p class="t-mono shiftlog-summary">
    {`${totalLabel} contributions · busiest week ${stats.busiestWeekTotal} · streak ${stats.currentStreak} days`}
  </p>
  <p class="t-mono small shiftlog-caption">
    data as of {data.fetchedAt}{sourceNote}
  </p>
  <div class="shiftlog-panel">
    <div class="shiftlog-scroll">
      <div class="shiftlog-cols">
        <div class="shiftlog-ticks t-mono" aria-hidden="true">
          {ticks.map((tick) => (
            <span class="shiftlog-tick" style={`--tick-col:${tick.weekIndex}`}>
              {tick.label}
            </span>
          ))}
        </div>
        <div class="shiftlog-grid" aria-hidden="true">
          {data.weeks.map((week) => (
            <div class="shiftlog-week">
              {week.days.map((day) => {
                const intensity = levelToIntensity(day.level);
                // data-level lets the torch read the 0-4 intensity without
                // parsing the class string (KTD5).
                return (
                  <span
                    class={`shiftlog-cell shiftlog-cell--${intensity}`}
                    data-level={intensity}
                  />
                );
              })}
            </div>
          ))}
        </div>
      </div>
    </div>
    <div class="shiftlog-legend t-mono" aria-hidden="true">
      <span class="shiftlog-legend-label">less</span>
      {legendLevels.map((level) => (
        <span class={`shiftlog-cell shiftlog-cell--${level}`} />
      ))}
      <span class="shiftlog-legend-label">more</span>
    </div>
  </div>
</div>

<script>
  import { glowFalloff, isGlowCandidate } from "../../lib/shift-log";

  // Cursor torch. Double-gate first (KTD2): only a fine pointer with motion
  // allowed attaches listeners — touch and prefers-reduced-motion keep the
  // static framed grid (R9). This is the codebase's first `pointer:` media
  // query, so the gate is covered by e2e and verified manually.
  const grid = document.querySelector<HTMLElement>(".shiftlog-grid");
  const finePointer = window.matchMedia("(pointer: fine)").matches;
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (grid && finePointer && !reduceMotion) {
    // Visually tuned in both palettes. Peak mix is held below the swatch-4 fill
    // (100% signal) so a hot day at the cursor never out-glows its own cell —
    // the effect reads as "the busy days light up as you pass," not a spotlight
    // (R8). If the day indigo-on-cream bloom ever reads harsh at this ceiling,
    // split MAX_MIX per palette rather than lowering it globally (KTD6).
    const RADIUS = 40; // px of cursor influence
    const MAX_BLUR = 8; // px box-shadow blur at the cursor
    const MAX_MIX = 55; // % --signal in the bloom at full intensity
    const MAX_SCALE = 1.25; // cell scale at full intensity

    type GlowCell = { el: HTMLElement; cx: number; cy: number };
    let cells: GlowCell[] = [];
    let pointerX = 0;
    let pointerY = 0;
    let frame = 0;

    // Cache each busy (intensity 3-4) cell's center relative to the grid.
    // offset*/dataset are transform-immune and scroll-invariant, so the cache
    // survives an active glow and the internal horizontal scroll (KTD5).
    const measure = () => {
      cells = [];
      for (const el of grid.querySelectorAll<HTMLElement>(".shiftlog-cell")) {
        if (!isGlowCandidate(Number(el.dataset.level))) continue;
        cells.push({
          el,
          cx: el.offsetLeft + el.offsetWidth / 2,
          cy: el.offsetTop + el.offsetHeight / 2,
        });
      }
    };

    const clearCell = (cell: GlowCell) => {
      cell.el.style.boxShadow = "";
      cell.el.style.transform = "";
    };

    const paint = () => {
      frame = 0;
      for (const cell of cells) {
        const dist = Math.hypot(pointerX - cell.cx, pointerY - cell.cy);
        const t = glowFalloff(dist, RADIUS);
        if (t <= 0) {
          clearCell(cell);
          continue;
        }
        const mix = (t * MAX_MIX).toFixed(1);
        const blur = (t * MAX_BLUR).toFixed(1);
        const scale = (1 + t * (MAX_SCALE - 1)).toFixed(3);
        // oklab, never oklch — signal↔transparent in oklch detours through
        // green (matches the cell ramp's own warning).
        cell.el.style.boxShadow = `0 0 ${blur}px color-mix(in oklab, var(--signal) ${mix}%, transparent)`;
        cell.el.style.transform = `scale(${scale})`;
      }
    };

    const onMove = (event: MouseEvent) => {
      // Cursor in grid-local coordinates; the live rect absorbs internal scroll.
      const rect = grid.getBoundingClientRect();
      pointerX = event.clientX - rect.left;
      pointerY = event.clientY - rect.top;
      if (!frame) frame = requestAnimationFrame(paint);
    };

    const onLeave = () => {
      if (frame) {
        cancelAnimationFrame(frame);
        frame = 0;
      }
      // R7 — no cell is left glowing once the cursor leaves the grid.
      for (const cell of cells) clearCell(cell);
    };

    measure();
    grid.addEventListener("mousemove", onMove);
    grid.addEventListener("mouseleave", onLeave);
    // Positions are layout-derived; recompute them when the grid reflows.
    window.addEventListener("resize", measure);
  }
</script>

<style>
  .shiftlog {
    /* Single source for the column pitch: cell edge + inter-cell gap. The grid,
       the week columns, and the absolutely-placed month ticks all derive their
       geometry from these, so ticks stay column-aligned if the cell size ever
       changes. */
    --cell: 8px;
    --cell-gap: 2px;
    --col-pitch: calc(var(--cell) + var(--cell-gap));
  }

  .shiftlog-summary {
    margin: 0 0 var(--s-1);
  }

  .shiftlog-caption {
    margin: 0 0 var(--s-3);
    /* --ink-soft, not --ink-mute: this is small mono (10.5px); --ink-mute
       fails WCAG AA in the day palette (4.32:1). See tokens.css:32-34. */
    color: var(--ink-soft);
  }

  /* Recessed instrument frame: the grid reads as an owned panel, not a
     github.com embed. --paper-2 sinks it below the page; --rule hairline and
     --r-2 corners give it an inset edge. */
  .shiftlog-panel {
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: var(--r-2);
    padding: var(--s-3);
  }

  .shiftlog-scroll {
    /* Grid is ~530px wide (53 cols × 8px + gaps) — wider than the 375px
       viewport. This container scrolls internally so the grid never causes
       horizontal PAGE overflow; the prose column stays fixed. */
    width: 100%;
    overflow-x: auto;
    /* overflow-x:auto computes overflow-y to a clipping value, which would
       shave the torch bloom + scale off the top (Sunday) and bottom (Saturday)
       rows — the rows the effect most needs. Vertical padding ≥ the max blur
       (8px) keeps the bloom inside the clip box. */
    padding-block: var(--s-3);
  }

  /* Ticks + grid share one inline-flex column so both pan together inside the
     scroll and the ticks row stretches to the grid's intrinsic width. */
  .shiftlog-cols {
    display: inline-flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .shiftlog-ticks {
    position: relative;
    align-self: stretch;
    height: 12px;
  }

  .shiftlog-tick {
    position: absolute;
    top: 0;
    /* Anchored to a real week column, not evenly spaced (R2). */
    left: calc(var(--tick-col) * var(--col-pitch));
    font-size: 10px;
    line-height: 1;
    white-space: nowrap;
    /* R4: small mono uses --ink-soft to clear WCAG AA in both palettes. axe
       skips this aria-hidden subtree, so this is verified visually. */
    color: var(--ink-soft);
  }

  .shiftlog-grid {
    /* position: relative makes the grid the offsetParent, so the torch reads
       each cell's offsetLeft/offsetTop against it (KTD5). The week columns stay
       static. */
    position: relative;
    display: inline-flex;
    gap: var(--cell-gap);
  }

  .shiftlog-week {
    display: flex;
    flex-direction: column;
    gap: var(--cell-gap);
  }

  .shiftlog-cell {
    display: block;
    width: var(--cell);
    height: var(--cell);
  }

  /* less → more legend: reuses the 0-4 swatches, right-aligned below the panel
     body, no per-column alignment needed so it sits outside the scroll. */
  .shiftlog-legend {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--s-1);
    margin-top: var(--s-3);
  }

  .shiftlog-legend-label {
    font-size: 10px;
    line-height: 1;
    color: var(--ink-soft);
  }

  /* Intensity → colour, signal scale. Levels 1-4 mix increasing --signal over
     paper so both night and day palettes (which redefine --signal/--paper
     via [data-time="day"]) stay correct without a duplicated rule set.
     Mix in oklab, NOT oklch: in BOTH palettes the accent and paper hues sit
     far apart (night amber ~70 vs paper ~250; day indigo ~268 vs cream ~100),
     so oklch hue interpolation detours through green and the low cells read as
     moss. oklab interpolates rectangularly — a clean ramp in either shift. */
  .shiftlog-cell--0 {
    background: var(--rule);
  }
  .shiftlog-cell--1 {
    background: color-mix(in oklab, var(--signal) 25%, var(--paper));
  }
  .shiftlog-cell--2 {
    background: color-mix(in oklab, var(--signal) 50%, var(--paper));
  }
  .shiftlog-cell--3 {
    background: color-mix(in oklab, var(--signal) 75%, var(--paper));
  }
  .shiftlog-cell--4 {
    background: var(--signal);
  }
</style>
