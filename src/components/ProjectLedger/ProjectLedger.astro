---
// ProjectLedger.astro — the shared index-page body for /work and /lab:
// eyebrow + intro up top, then the ledger (title / mono outcome datum /
// status chip). One copy of the markup and styles; the two routes differ
// only in copy and which category of projects they pass in.

import {
  type ProjectSummary,
  projectHref,
  projectStatus,
} from "../../lib/projects";
import StatusChip from "../StatusChip/StatusChip.astro";

interface Props {
  eyebrow: string;
  intro: string;
  heading: string;
  emptyText: string;
  projects: ProjectSummary[];
}

const { eyebrow, intro, heading, emptyText, projects } = Astro.props;
---

<div class="work">
  <section class="work-head">
    <p class="t-label work-eyebrow">{eyebrow}</p>
    <p class="work-intro">{intro}</p>
  </section>

  <section class="ledger-section" aria-labelledby="ledger-heading">
    <div class="section-head">
      <h2 id="ledger-heading" class="t-label">{heading}</h2>
    </div>

    {
      projects.length > 0 ? (
        <ol class="ledger">
          {projects.map((p) => {
            const status = projectStatus(p);
            return (
              <li class="ledger-row">
                <a class="ledger-link" href={projectHref(p)}>
                  <span class="ledger-name">{p.title}</span>
                  <span class="t-mono ledger-datum">{p.outcome}</span>
                  <StatusChip status={status} variant="chip" />
                </a>
              </li>
            );
          })}
        </ol>
      ) : (
        <p class="t-mono ledger-empty">{emptyText}</p>
      )
    }
  </section>
</div>

<style>
  .work {
    max-width: 960px;
    margin-inline: auto;
    padding: var(--s-7) var(--s-4) var(--s-8);
    display: flex;
    flex-direction: column;
    gap: var(--s-7);
  }

  .work-head {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .work-eyebrow {
    margin: 0;
  }

  .work-intro {
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 60ch;
    margin: 0;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-4);
    border-bottom: 1px solid var(--ink);
    padding-bottom: var(--s-2);
  }

  .section-head h2 {
    margin: 0;
    color: var(--ink-soft);
  }

  .ledger {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ledger-row {
    border-bottom: 1px solid var(--rule);
  }

  .ledger-link {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--s-5);
    padding: var(--s-4) var(--s-2);
    text-decoration: none;
    transition: background 150ms ease;
  }

  @media (hover: hover) {
    .ledger-link:hover {
      background: var(--paper-2);
    }
  }

  .ledger-name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 17px;
    color: var(--ink);
    line-height: 1.35;
  }

  .ledger-datum {
    text-transform: none;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
  }

  .ledger-empty {
    padding: var(--s-5) var(--s-2);
    margin: 0;
  }

  @media (max-width: 680px) {
    .ledger-link {
      grid-template-columns: 1fr auto;
    }
    .ledger-datum {
      grid-column: 1 / -1;
      order: 3;
    }
  }
</style>
