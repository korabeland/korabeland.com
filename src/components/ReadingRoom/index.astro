---
// ReadingRoom/index.astro — three-column blog reading layout.
// 220px sidebar · 620px reading column · 260px margin-notes rail.

import { loadHeroPicture } from "../../lib/hero-picture";
import LeftSidebar from "./LeftSidebar.astro";
import RightSidebar from "./RightSidebar.astro";

interface MarginNote {
  superscript: string;
  body: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  titleEm?: string;
  subtitle?: string;
  noteNumber?: string;
  date: string;
  readTime: string;
  wordCount?: number;
  tags?: string[];
  contents?: Array<{ label: string; activeIndex?: boolean }>;
  marginNotes?: MarginNote[];
  backHref?: string;
  backLabel?: string;
  heroImage?: string;
  heroImageAlt?: string;
}

const {
  eyebrow = "§ · field notes",
  title,
  titleEm,
  subtitle,
  noteNumber,
  date,
  readTime,
  wordCount,
  tags = [],
  contents = [],
  marginNotes = [],
  backHref = "/notes",
  backLabel = "← back to notes",
  heroImage,
  heroImageAlt = "",
} = Astro.props;

// heroImage is the bare Keystatic filename; variants live in public/notes/
// (this collection's fixed heroImage `directory`). Plumbing shared with
// CaseStudy via src/lib/hero-picture.ts.
const hero = heroImage
  ? loadHeroPicture("public/notes", heroImage, "ReadingRoom")
  : null;
const HERO_SIZES = "(max-width: 680px) 100vw, 620px";
---

<div class="return">
  <a class="t-mono" href={backHref}>{backLabel}</a>
</div>

<article class="reading-room">
  <LeftSidebar
    noteNumber={noteNumber}
    date={date}
    readTime={readTime}
    wordCount={wordCount}
    tags={tags}
    contents={contents}
  />

  <div class="column">
    <div class="eyebrow t-label">{eyebrow}</div>
    <h1 class="t-display title">
      {title}{titleEm && <> <span class="title-em">{titleEm}</span></>}
    </h1>
    {subtitle && (
      <p class="subtitle">{subtitle}</p>
    )}

    <div class="rule-soft rule-top"></div>

    {hero && (
      <figure class="hero">
        <picture>
          <source type="image/avif" srcset={hero.avifSrcset} sizes={HERO_SIZES} />
          <source type="image/webp" srcset={hero.webpSrcset} sizes={HERO_SIZES} />
          <img
            src={hero.fallbackSrc}
            alt={heroImageAlt}
            width={hero.width}
            height={hero.height}
            loading="eager"
            fetchpriority="high"
            sizes={HERO_SIZES}
          />
        </picture>
      </figure>
    )}

    <div class="post-body">
      <slot />
    </div>
  </div>

  <RightSidebar marginNotes={marginNotes} />
</article>

<style>
  .return {
    padding: var(--s-5) var(--s-6) 0;
  }
  .return .t-mono {
    color: var(--ink-soft);
    text-decoration: none;
  }
  .return .t-mono:hover,
  .return .t-mono:focus-visible {
    color: var(--signal);
  }

  .reading-room {
    display: grid;
    grid-template-columns: 220px 1fr 260px;
    gap: var(--s-7);
    padding: var(--s-8) var(--s-6) var(--s-9);
    max-width: 1320px;
    margin: 0 auto;
  }

  .column {
    max-width: 620px;
  }

  .eyebrow {
    margin-bottom: var(--s-4);
  }
  .title {
    font-size: clamp(28px, 4vw, 40px);
    margin: 0 0 var(--s-5);
  }
  .title-em {
    color: var(--signal);
  }
  .subtitle {
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0 0 var(--s-7);
    max-width: 52ch;
  }
  .rule-top {
    margin: var(--s-6) 0 var(--s-7);
  }

  .hero {
    margin: 0 0 var(--s-7);
  }
  .hero img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 2px;
  }

  /* Body prose — console type scale. DocumentRenderer emits plain
     <p>/<h2>/<ul> so we target them generically. */
  .post-body :global(p) {
    font-size: 17px;
    line-height: 1.7;
    margin: 0 0 var(--s-5);
  }
  .post-body :global(h2) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 28px;
    letter-spacing: -0.02em;
    margin: var(--s-8) 0 var(--s-4);
    color: var(--ink);
  }
  .post-body :global(h3) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.01em;
    margin: var(--s-6) 0 var(--s-3);
    color: var(--ink);
  }
  .post-body :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .post-body :global(a:hover),
  .post-body :global(a:focus-visible) {
    color: var(--signal);
  }
  .post-body :global(blockquote) {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 20px;
    line-height: 1.45;
    margin: var(--s-7) 0;
    padding-left: var(--s-5);
    border-left: 2px solid var(--signal);
    color: var(--ink-soft);
  }
  .post-body :global(figure) {
    margin: var(--s-7) 0;
  }
  .post-body :global(figcaption) {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    margin-top: var(--s-2);
  }
  .post-body :global(ul),
  .post-body :global(ol) {
    font-size: 17px;
    line-height: 1.7;
    margin: 0 0 var(--s-5) 0;
    padding-left: var(--s-5);
  }
  .post-body :global(ul) {
    list-style: disc outside;
  }
  .post-body :global(ol) {
    list-style: decimal outside;
  }
  .post-body :global(li) {
    margin-block: var(--s-2);
  }

  @media (max-width: 1200px) {
    .reading-room {
      grid-template-columns: 1fr;
    }
    .column {
      max-width: 100%;
    }
  }
</style>
