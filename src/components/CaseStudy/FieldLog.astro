---
// FieldLog.astro — chronological entries from the build. Mono week column +
// display title + prose body row.

interface Entry {
  week: string;
  title: string;
  body: string;
}

interface Props {
  entries: Entry[];
}

const { entries } = Astro.props;
---

<div class="log">
  {entries.map((e) => (
    <div class="entry">
      <div class="t-mono week">{e.week}</div>
      <div>
        <div class="title">{e.title}</div>
        <div class="body">{e.body}</div>
      </div>
    </div>
  ))}
</div>

<style>
  .log {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
    max-width: 680px;
  }
  .entry {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: var(--s-4);
    padding-bottom: var(--s-5);
    border-bottom: 1px solid var(--rule);
  }
  .week {
    color: var(--amber);
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 16px;
    color: var(--ink);
    margin-bottom: 4px;
  }
  .body {
    font-size: 15px;
    color: var(--ink-soft);
    line-height: 1.6;
  }
  @media (max-width: 640px) {
    .entry {
      grid-template-columns: 1fr;
      gap: var(--s-2);
    }
  }
</style>
