---
// FactStrip.astro — bordered mono grid: Role / Team / Stack / Span / Status.

interface Fact {
  label: string;
  value: string;
}

interface Props {
  facts: Fact[];
}

const { facts } = Astro.props;
---

<section class="strip">
  <div class="strip-inner">
    {facts.map((f) => (
      <div class="fact">
        <div class="t-label fact-label">{f.label}</div>
        <div class="t-mono fact-value">{f.value}</div>
      </div>
    ))}
  </div>
</section>

<style>
  .strip {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    background: var(--paper-2);
  }
  .strip-inner {
    max-width: 1000px;
    margin: 0 auto;
    padding: var(--s-5) var(--s-4);
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--s-5);
  }
  .fact {
    border-left: 1px solid var(--rule);
    padding-left: var(--s-3);
  }
  .fact:first-child {
    border-left: none;
    padding-left: 0;
  }
  .fact-label {
    margin: 0 0 4px;
  }
  .fact-value {
    text-transform: none;
    letter-spacing: 0.02em;
    color: var(--ink);
    font-size: 12.5px;
  }
  @media (max-width: 800px) {
    .strip-inner {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--s-4);
    }
    .fact {
      border-left: none;
      padding-left: 0;
    }
  }
</style>
