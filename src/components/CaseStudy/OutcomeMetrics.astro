---
// OutcomeMetrics.astro — bordered rows: label · mono amber value.
// DESIGN.md §4 "Metrics block".

interface Metric {
  value: string;
  label: string;
}

interface Props {
  metrics: Metric[];
}

const { metrics } = Astro.props;
---

<div class="metrics">
  {metrics.map((m) => (
    <div class="metric">
      <span class="metric-label">{m.label}</span>
      <span class="t-mono metric-value">{m.value}</span>
    </div>
  ))}
</div>

<style>
  .metrics {
    display: flex;
    flex-direction: column;
    max-width: 680px;
  }
  .metric {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-5);
    padding: var(--s-3) 0;
    border-bottom: 1px solid var(--rule);
  }
  .metric:first-child {
    border-top: 1px solid var(--rule);
  }
  .metric-label {
    font-size: 15px;
    color: var(--ink-soft);
  }
  .metric-value {
    text-transform: none;
    letter-spacing: 0.02em;
    color: var(--amber);
    font-size: 15px;
    font-weight: 500;
    white-space: nowrap;
  }
</style>
