---
// OutcomeMetrics.astro — bordered rows: label · mono amber value. Clean numeric
// values (e.g. "42", "90%", "3x") count up from zero when they scroll into
// view; ranges and words render static. The server-rendered markup always
// carries the final value, so no-JS and reduced-motion visitors see it
// immediately — the script self-disables under prefers-reduced-motion.
// DESIGN.md §4 "Metrics block".
//
// R2/AE4 — every metric answers "according to whom, measured how, over what
// period" via a native <details>/<summary> disclosure. The row becomes a
// <details> element; <summary> keeps the existing label/value markup plus a
// mono marker glyph. Click/tap/Enter toggle it natively — no JS required, no
// tooltip library, no island.

import { parseCountUp } from "../../lib/metric-countup";

interface Metric {
  value: string;
  label: string;
  provenance: string;
}

interface Props {
  metrics: Metric[];
}

const { metrics } = Astro.props;

const rows = metrics.map((m) => ({ ...m, countUp: parseCountUp(m.value) }));
---

<div class="metrics">
  {rows.map((m) => (
    <details class="metric-details">
      <summary class="metric">
        <span class="metric-label">{m.label}</span>
        <span class="metric-value-group">
          <span
            class="t-mono metric-value"
            data-countup-target={m.countUp.animatable ? m.countUp.target : undefined}
            data-countup-suffix={m.countUp.animatable ? m.countUp.suffix : undefined}
          >{m.value}</span>
          <span class="metric-marker t-mono" aria-hidden="true">＋</span>
        </span>
      </summary>
      <p class="metric-provenance t-mono">{m.provenance}</p>
    </details>
  ))}
</div>

<script>
  // Count-up enhancement. Values that passed the build-time parser carry
  // data-countup-* attributes; every other readout is left untouched. Guarded
  // by prefers-reduced-motion — the server already rendered the final value, so
  // reduced-motion and no-JS visitors simply keep it.
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (!reduce.matches) {
    const animate = (el: HTMLElement) => {
      const target = Number(el.dataset.countupTarget);
      const suffix = el.dataset.countupSuffix ?? "";
      if (!Number.isFinite(target)) return;
      const settle = () => {
        el.textContent = target + suffix;
      };
      // A backgrounded / throttled tab can't animate smoothly — show the real
      // value rather than risk leaving a metric stuck mid-count.
      if (document.hidden) {
        settle();
        return;
      }
      const durationMs = 900;
      let startTs: number | null = null;
      const step = (ts: number) => {
        if (startTs === null) startTs = ts;
        const progress = Math.min(1, (ts - startTs) / durationMs);
        const eased = 1 - (1 - progress) ** 3;
        el.textContent = Math.round(eased * target) + suffix;
        if (progress < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
      // Safety net: guarantee the final value even if rAF is throttled and
      // never reaches the last frame. A real metric must never stick at zero.
      window.setTimeout(settle, durationMs + 200);
    };

    const observer = new IntersectionObserver(
      (entries, obs) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          obs.unobserve(entry.target);
          animate(entry.target as HTMLElement);
        }
      },
      { threshold: 0.6 },
    );

    for (const el of document.querySelectorAll<HTMLElement>(
      "[data-countup-target]",
    )) {
      observer.observe(el);
    }
  }
</script>

<style>
  .metrics {
    display: flex;
    flex-direction: column;
    max-width: 680px;
  }
  .metric-details {
    border-bottom: 1px solid var(--rule);
  }
  .metric-details:first-child {
    border-top: 1px solid var(--rule);
  }
  .metric {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-5);
    padding: var(--s-3) 0;
    cursor: pointer;
    list-style: none;
  }
  .metric::-webkit-details-marker {
    display: none;
  }
  .metric::marker {
    content: "";
  }
  .metric:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }
  .metric-label {
    font-size: 15px;
    color: var(--ink-soft);
    min-width: 0;
  }
  .metric-value-group {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .metric-value {
    text-transform: none;
    letter-spacing: 0.02em;
    color: var(--amber);
    font-size: 15px;
    font-weight: 500;
    white-space: nowrap;
  }
  .metric-marker {
    font-size: 13px;
    color: var(--ink-soft);
    transition: color 160ms ease;
  }
  .metric:hover .metric-marker,
  .metric:focus-visible .metric-marker {
    color: var(--amber);
  }
  .metric-details[open] .metric-marker {
    color: var(--amber);
  }
  .metric-provenance {
    margin: 0 0 var(--s-3);
    text-transform: none;
    letter-spacing: normal;
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 100%;
    overflow-wrap: break-word;
  }
</style>
