---
// CaseStudy/index.astro — case-study page layout, console skin. Fact strip
// (Role/Team/Stack/Span/Status) up top, outcome metrics right after the
// first prose block, then field log / reflection / next-project.
// Motion moment 3 of 3: reading-progress meter, CSS scroll-driven, guarded
// by @supports + prefers-reduced-motion. See DESIGN.md §4-5.

import { loadHeroPicture } from "../../lib/hero-picture";
import SectionHead from "../SectionHead.astro";
import StatusChip from "../StatusChip/StatusChip.astro";
import FactStrip from "./FactStrip.astro";
import FieldLog from "./FieldLog.astro";
import OutcomeMetrics from "./OutcomeMetrics.astro";

interface Fact {
  label: string;
  value: string;
}
interface Metric {
  value: string;
  label: string;
  provenance: string;
}
interface LogEntry {
  week: string;
  title: string;
  body: string;
}

interface Props {
  title: string;
  subtitle?: string;
  /** "in flight" | "shipped" — drives the status chip colour. */
  status?: string;
  facts: Fact[];
  heroImage?: string;
  heroImageAlt?: string;
  fieldLog?: LogEntry[];
  outcomeMetrics?: Metric[];
  reflection?: string;
  nextProject?: { href: string; title: string };
  backHref?: string;
  backLabel?: string;
  eyebrowLabel?: string;
}

const {
  title,
  subtitle,
  status,
  facts,
  heroImage,
  heroImageAlt = "",
  fieldLog = [],
  outcomeMetrics = [],
  reflection,
  nextProject,
  backHref = "/work",
  backLabel = "← all case studies",
  eyebrowLabel = "case study",
} = Astro.props;

// heroImage is the bare Keystatic filename; variants live in public/work/
// (this collection's fixed heroImage `directory`). Plumbing shared with
// ReadingRoom via src/lib/hero-picture.ts.
const hero = heroImage
  ? loadHeroPicture("public/work", heroImage, "CaseStudy")
  : null;
// Keyed to .head's own max-width — the --w-shell token, 960px (see below) —
// deliberately not shared with ReadingRoom's --w-prose reading-column value.
const HERO_SIZES = "(max-width: 960px) 100vw, 960px";
---

<div class="progress-track" aria-hidden="true">
  <div class="progress-bar"></div>
</div>

<div class="return">
  <a class="t-mono" href={backHref}>{backLabel}</a>
</div>

{/* HEADER */}
<section class="head">
  <div class="head-meta">
    <span class="t-label">{eyebrowLabel}</span>
    {status && (
      <StatusChip
        status={status === "shipped" ? "shipped" : "in-flight"}
        variant="chip"
        label={status}
      />
    )}
  </div>

  <h1 class="t-display head-title">{title}</h1>
  {subtitle && <p class="head-subtitle">{subtitle}</p>}

  {hero && (
    <picture>
      <source type="image/avif" srcset={hero.avifSrcset} sizes={HERO_SIZES} />
      <source type="image/webp" srcset={hero.webpSrcset} sizes={HERO_SIZES} />
      <img
        class="head-image"
        src={hero.fallbackSrc}
        alt={heroImageAlt}
        width={hero.width}
        height={hero.height}
        loading="eager"
        fetchpriority="high"
        sizes={HERO_SIZES}
      />
    </picture>
  )}
</section>

{/* Fact strip: Role / Team / Stack / Span / Status */}
<FactStrip facts={facts} />

{/* Body */}
<section class="body">
  <div class="prose">
    <slot />
  </div>

  {outcomeMetrics.length > 0 && (
    <section class="outcome" aria-labelledby="outcome-heading">
      <SectionHead id="outcome-heading" text="outcome" />
      <OutcomeMetrics metrics={outcomeMetrics} />
    </section>
  )}

  {fieldLog.length > 0 && (
    <section class="field-log" aria-labelledby="log-heading">
      <SectionHead id="log-heading" text="field log" />
      <FieldLog entries={fieldLog} />
    </section>
  )}

  {reflection && (
    <section class="reflection" aria-labelledby="reflection-heading">
      <SectionHead id="reflection-heading" text="reflection" />
      <p class="reflection-body">{reflection}</p>
    </section>
  )}

  <div class="rule-soft rule-next"></div>
  {nextProject && (
    <div class="next-row">
      <span class="t-mono">next {eyebrowLabel}</span>
      <a class="next-link" href={nextProject.href}>{nextProject.title}</a>
    </div>
  )}
</section>

<style>
  /* ─── Motion moment 3 of 3: reading progress ──────────────────────────
     CSS scroll-driven animation where supported; a static, unanimated bar
     as the fallback so the meter never looks broken on unsupported
     browsers. prefers-reduced-motion is covered by the global guard in
     global.css, which zeroes animation-duration — the bar simply stops
     tracking and sits still, which is an acceptable degraded state.

     Fixed (not sticky) and pinned above the chrome header: a sticky bar at
     top:0 shares the header's own sticky position, and the header's higher
     z-index hid it completely. Fixed positioning also escapes page-main's
     max-width, so the bar spans the full viewport without needing fullBleed. */
  .progress-track {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    height: 2px;
    background: var(--rule);
  }

  .progress-bar {
    height: 100%;
    background: var(--signal);
    width: 0%;
    transform-origin: left;
  }

  @supports (animation-timeline: scroll()) {
    .progress-bar {
      width: 100%;
      transform: scaleX(0);
      animation: reading-progress linear;
      animation-timeline: scroll(root);
    }

    @keyframes reading-progress {
      to {
        transform: scaleX(1);
      }
    }
  }

  .return {
    max-width: var(--w-shell);
    margin: 0 auto;
    padding: var(--s-5) var(--s-4) 0;
  }
  .return .t-mono {
    color: var(--ink-soft);
    text-decoration: none;
  }
  .return .t-mono:hover,
  .return .t-mono:focus-visible {
    color: var(--signal);
  }

  .head {
    max-width: var(--w-shell);
    margin: 0 auto;
    padding: var(--s-6) var(--s-4) var(--s-6);
  }

  .head-meta {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-bottom: var(--s-4);
  }

  .head-title {
    font-size: clamp(32px, 5vw, 48px);
    margin: 0 0 var(--s-4);
    max-width: 20ch;
  }

  .head-subtitle {
    font-size: 18px;
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 60ch;
    margin: 0 0 var(--s-5);
  }

  .head-image {
    width: 100%;
    max-height: 420px;
    object-fit: cover;
    border: 1px solid var(--rule);
    display: block;
  }

  .body {
    max-width: var(--w-shell);
    margin: 0 auto;
    padding: var(--s-7) var(--s-4) var(--s-8);
  }

  .prose {
    max-width: var(--w-prose);
  }

  .prose :global(p) {
    font-size: 17px;
    line-height: 1.7;
    color: var(--ink-soft);
    margin: 0 0 var(--s-5);
  }
  .prose :global(h2) {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 24px;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: var(--s-7) 0 var(--s-4);
  }
  .prose :global(strong) {
    color: var(--ink);
  }
  .prose :global(blockquote) {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 20px;
    line-height: 1.45;
    margin: var(--s-6) 0;
    padding-left: var(--s-5);
    border-left: 2px solid var(--signal);
    color: var(--ink);
  }
  .prose :global(ul) {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--s-5);
  }
  .prose :global(ul li) {
    padding-block: var(--s-2);
    border-bottom: 1px solid var(--rule);
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .outcome,
  .field-log,
  .reflection {
    --section-head-margin: var(--s-8) 0 var(--s-5);
    --section-head-max-width: var(--w-prose);
  }

  .reflection-body {
    font-size: 17px;
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: var(--w-prose);
    margin: 0;
  }

  .rule-next {
    margin: var(--s-8) 0 var(--s-5);
    max-width: var(--w-prose);
  }

  .next-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-4);
    max-width: var(--w-prose);
  }

  .next-link {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 18px;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 160ms ease, color 160ms ease;
  }
  .next-link:hover,
  .next-link:focus-visible {
    color: var(--signal);
    border-bottom-color: var(--signal);
  }

  @media (max-width: 680px) {
    .head-meta {
      flex-wrap: wrap;
    }
  }
</style>
