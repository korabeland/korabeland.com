---
// CaseStudy/index.astro — case-study page layout, console skin. Fact strip
// (Role/Team/Stack/Span/Status) up top, outcome metrics right after the
// first prose block, then field log / reflection / next-project.
// Motion moment 3 of 3: reading-progress meter, CSS scroll-driven, guarded
// by @supports + prefers-reduced-motion. See DESIGN.md §4-5.

import FactStrip from "./FactStrip.astro";
import FieldLog from "./FieldLog.astro";
import OutcomeMetrics from "./OutcomeMetrics.astro";

interface Fact {
  label: string;
  value: string;
}
interface Metric {
  value: string;
  label: string;
}
interface LogEntry {
  week: string;
  title: string;
  body: string;
}

interface Props {
  title: string;
  subtitle?: string;
  /** "in flight" | "shipped" — drives the status chip colour. */
  status?: string;
  facts: Fact[];
  heroImage?: string;
  heroImageAlt?: string;
  fieldLog?: LogEntry[];
  outcomeMetrics?: Metric[];
  reflection?: string;
  nextProject?: { slug: string; title: string };
  backHref?: string;
  backLabel?: string;
}

const {
  title,
  subtitle,
  status,
  facts,
  heroImage,
  heroImageAlt = "",
  fieldLog = [],
  outcomeMetrics = [],
  reflection,
  nextProject,
  backHref = "/work",
  backLabel = "← all case studies",
} = Astro.props;

const statusKind = status === "shipped" ? "shipped" : "active";
---

<div class="progress-track" aria-hidden="true">
  <div class="progress-bar"></div>
</div>

<div class="return">
  <a class="t-mono" href={backHref}>{backLabel}</a>
</div>

{/* HEADER */}
<section class="head">
  <div class="head-meta">
    <span class="t-label">case study</span>
    {status && (
      <span class={`chip chip--${statusKind}`}>{status}</span>
    )}
  </div>

  <h1 class="t-display head-title">{title}</h1>
  {subtitle && <p class="head-subtitle">{subtitle}</p>}

  {heroImage && <img class="head-image" src={heroImage} alt={heroImageAlt} />}
</section>

{/* Fact strip: Role / Team / Stack / Span / Status */}
<FactStrip facts={facts} />

{/* Body */}
<section class="body">
  <div class="prose">
    <slot />
  </div>

  {outcomeMetrics.length > 0 && (
    <section class="outcome" aria-labelledby="outcome-heading">
      <h2 id="outcome-heading" class="t-label outcome-heading">outcome</h2>
      <OutcomeMetrics metrics={outcomeMetrics} />
    </section>
  )}

  {fieldLog.length > 0 && (
    <section class="field-log" aria-labelledby="log-heading">
      <h2 id="log-heading" class="t-label log-heading">field log</h2>
      <FieldLog entries={fieldLog} />
    </section>
  )}

  {reflection && (
    <section class="reflection" aria-labelledby="reflection-heading">
      <h2 id="reflection-heading" class="t-label reflection-heading">reflection</h2>
      <p class="reflection-body">{reflection}</p>
    </section>
  )}

  <div class="rule-soft rule-next"></div>
  {nextProject && (
    <div class="next-row">
      <span class="t-mono">next case study</span>
      <a class="next-link" href={`/work/${nextProject.slug}`}>{nextProject.title}</a>
    </div>
  )}
</section>

<style>
  /* ─── Motion moment 3 of 3: reading progress ──────────────────────────
     CSS scroll-driven animation where supported; a static, unanimated bar
     as the fallback so the meter never looks broken on unsupported
     browsers. prefers-reduced-motion is covered by the global guard in
     global.css, which zeroes animation-duration — the bar simply stops
     tracking and sits still, which is an acceptable degraded state.

     Fixed (not sticky) and pinned above the chrome header: a sticky bar at
     top:0 shares the header's own sticky position, and the header's higher
     z-index hid it completely. Fixed positioning also escapes page-main's
     max-width, so the bar spans the full viewport without needing fullBleed. */
  .progress-track {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    height: 2px;
    background: var(--rule);
  }

  .progress-bar {
    height: 100%;
    background: var(--amber);
    width: 0%;
    transform-origin: left;
  }

  @supports (animation-timeline: scroll()) {
    .progress-bar {
      width: 100%;
      transform: scaleX(0);
      animation: reading-progress linear;
      animation-timeline: scroll(root);
    }

    @keyframes reading-progress {
      to {
        transform: scaleX(1);
      }
    }
  }

  .return {
    max-width: 1000px;
    margin: 0 auto;
    padding: var(--s-5) var(--s-4) 0;
  }
  .return .t-mono {
    color: var(--ink-mute);
    text-decoration: none;
  }
  .return .t-mono:hover,
  .return .t-mono:focus-visible {
    color: var(--amber);
  }

  .head {
    max-width: 1000px;
    margin: 0 auto;
    padding: var(--s-6) var(--s-4) var(--s-6);
  }

  .head-meta {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-bottom: var(--s-4);
  }

  .chip {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 3px 8px;
    border: 1px solid;
    white-space: nowrap;
  }
  .chip--active {
    color: var(--amber);
    border-color: var(--amber);
  }
  .chip--shipped {
    color: var(--moss);
    border-color: var(--moss);
  }

  .head-title {
    font-size: clamp(32px, 5vw, 48px);
    margin: 0 0 var(--s-4);
    max-width: 20ch;
  }

  .head-subtitle {
    font-size: 18px;
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 60ch;
    margin: 0 0 var(--s-5);
  }

  .head-image {
    width: 100%;
    max-height: 420px;
    object-fit: cover;
    border: 1px solid var(--rule);
    display: block;
  }

  .body {
    max-width: 1000px;
    margin: 0 auto;
    padding: var(--s-7) var(--s-4) var(--s-8);
  }

  .prose {
    max-width: 680px;
  }

  .prose :global(p) {
    font-size: 17px;
    line-height: 1.7;
    color: var(--ink-soft);
    margin: 0 0 var(--s-5);
  }
  .prose :global(h2) {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 24px;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: var(--s-7) 0 var(--s-4);
  }
  .prose :global(strong) {
    color: var(--ink);
  }
  .prose :global(blockquote) {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 20px;
    line-height: 1.45;
    margin: var(--s-6) 0;
    padding-left: var(--s-5);
    border-left: 2px solid var(--amber);
    color: var(--ink);
  }
  .prose :global(ul) {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--s-5);
  }
  .prose :global(ul li) {
    padding-block: var(--s-2);
    border-bottom: 1px solid var(--rule);
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .outcome-heading,
  .log-heading,
  .reflection-heading {
    display: block;
    border-bottom: 1px solid var(--ink);
    padding-bottom: var(--s-2);
    margin: var(--s-8) 0 var(--s-5);
    max-width: 680px;
  }

  .reflection-body {
    font-size: 17px;
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 680px;
    margin: 0;
  }

  .rule-next {
    margin: var(--s-8) 0 var(--s-5);
    max-width: 680px;
  }

  .next-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-4);
    max-width: 680px;
  }

  .next-link {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 18px;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 160ms ease, color 160ms ease;
  }
  .next-link:hover,
  .next-link:focus-visible {
    color: var(--amber);
    border-bottom-color: var(--amber);
  }

  @media (max-width: 680px) {
    .head-meta {
      flex-wrap: wrap;
    }
  }
</style>
