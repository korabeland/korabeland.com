---
// OffTrail.astro — shared 404-adjacent empty state.
//
// Used by both src/pages/404.astro (unknown URL) and
// src/pages/off-trail.astro (known but unshipped route, signalled by
// `?from=<slug>`).
//
// Minimal console empty state: mono eyebrow, one understated line, an
// optional subline naming the destination, and a button back to /.

interface Props {
  /**
   * Known destination slug from a retired or not-yet-shipped route
   * (e.g. `notes`, `work`). Any unknown value falls back to the generic copy.
   */
  from?: string;
}

const { from } = Astro.props;

const KNOWN_DESTINATIONS: Record<string, string> = {
  notes: "field notes",
  work: "case studies",
};

const destinationLabel = from ? KNOWN_DESTINATIONS[from] : undefined;
const hasSubline = Boolean(destinationLabel);
const subline = destinationLabel
  ? `${destinationLabel}: not live yet`
  : undefined;
---

<section class="off-trail" aria-labelledby="off-trail-title">
  <p class="t-label eyebrow" id="off-trail-title">no signal</p>
  <p class="dek">This page does not exist.</p>
  {hasSubline && <p class="t-mono subline">{subline}</p>}
  <a class="btn" href="/">back to the console</a>
</section>

<style>
  .off-trail {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-4);
    padding-block: var(--s-9);
    text-align: center;
  }

  .eyebrow {
    color: var(--signal);
  }

  .dek {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: clamp(24px, 4vw, 32px);
    line-height: 1.2;
    color: var(--ink);
    max-width: 32ch;
    margin: 0;
  }

  .subline {
    color: var(--ink-soft);
    margin: 0;
  }

  .btn {
    margin-top: var(--s-4);
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink);
    border: 1px solid var(--ink);
    padding: 10px 16px;
    text-decoration: none;
    transition:
      background 200ms ease,
      color 200ms ease;
  }

  .btn:hover,
  .btn:focus-visible {
    background: var(--ink);
    color: var(--paper);
  }
</style>
