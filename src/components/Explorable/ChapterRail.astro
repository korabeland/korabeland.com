---
// Explorable/ChapterRail.astro: a story's chapters as a numbered readout, one
// real datum per chapter. With `href` on an item the row is a jump link to
// that chapter; without it the rail is a static summary (the work listing's
// featured block uses it that way, inside one larger link).
//
// Zero client JS, no motion beyond the 150ms hover colour (DESIGN.md §9).

import type { RailChapter } from "../../lib/explorable";

interface Props {
  chapters: readonly RailChapter[];
  /** Accessible name for the list, e.g. "Chapters". */
  label: string;
}

const { chapters, label } = Astro.props;
const number = (i: number) => String(i + 1).padStart(2, "0");
---

<ol class="cr" aria-label={label}>
  {
    chapters.map((chapter, i) => {
      const inner = (
        <>
          <span class="cr-n">{number(i)}</span>
          <span class="cr-datum">{chapter.datum}</span>
          <span class="cr-caption">{chapter.caption}</span>
        </>
      );
      return (
        <li class="cr-item">
          {chapter.href ? (
            <a class="cr-row" href={chapter.href}>
              {inner}
            </a>
          ) : (
            <span class="cr-row">{inner}</span>
          )}
        </li>
      );
    })
  }
</ol>

<style>
  /* Doubled class: beats the case-study prose list rule, which would
     otherwise restyle these rows. */
  .cr.cr {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    border: 1px solid var(--rule);
    border-top-color: var(--ink);
  }

  .cr.cr .cr-item {
    padding: 0;
    border-bottom: 0;
    border-right: 1px solid var(--rule);
    min-width: 0;
  }
  .cr.cr .cr-item:last-child {
    border-right: 0;
  }

  .cr-row {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    height: 100%;
    min-height: 44px;
    padding: var(--s-4);
    text-decoration: none;
    transition: background 150ms ease;
  }

  .cr-n {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
  }

  .cr-datum {
    font-family: var(--font-mono);
    font-size: 17px;
    line-height: 1.3;
    letter-spacing: 0.01em;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
    white-space: nowrap;
  }

  .cr-caption {
    font-size: 14px;
    line-height: 1.4;
    color: var(--ink-soft);
  }

  a.cr-row:focus-visible {
    position: relative;
    z-index: 1;
  }
  @media (hover: hover) {
    a.cr-row:hover {
      background: var(--paper-2);
    }
    a.cr-row:hover .cr-datum {
      color: var(--signal);
    }
  }

  @media (max-width: 680px) {
    .cr.cr {
      grid-auto-flow: row;
    }
    .cr.cr .cr-item {
      border-right: 0;
      border-bottom: 1px solid var(--rule);
    }
    .cr.cr .cr-item:last-child {
      border-bottom: 0;
    }
    .cr-row {
      display: grid;
      grid-template-columns: 24px minmax(0, 1fr);
      align-items: baseline;
      gap: var(--s-1) var(--s-3);
      padding: var(--s-3) var(--s-4);
    }
    .cr-caption {
      grid-column: 2;
    }
  }
</style>
