---
// The button that opens the Ask panel. Server-rendered `hidden`: a visitor
// without JavaScript never sees a control that does nothing. AskPanel's script
// reveals it and wires the click.
---

<button class="ask-trigger" type="button" data-ask-open hidden>
  ask about my work
</button>

<style>
  .ask-trigger {
    position: relative;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    padding: 9px 15px;
    background: transparent;
    color: var(--ink-soft);
    border: 1px solid var(--rule);
    border-radius: var(--r-0);
    cursor: pointer;
    transition:
      color 200ms ease,
      border-color 200ms ease;
  }
  .ask-trigger:hover,
  .ask-trigger:focus-visible {
    color: var(--ink);
    border-color: var(--signal);
  }
  .ask-trigger:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }
  /* 44px tap target without moving a pixel (see global.css hit areas). */
  .ask-trigger::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: max(100%, 44px);
    height: max(100%, 44px);
  }
</style>
