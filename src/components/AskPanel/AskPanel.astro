---
// AskPanel — the optional "Ask about my work" search panel.
//
// A native <dialog>, so the browser supplies the focus trap, Escape to close
// and focus return. Search runs in the visitor's browser over /ask-index.json;
// no model is called and no question text is sent anywhere. History lives in
// sessionStorage (src/lib/ask/history.ts). The only thing the server ever
// hears is an event name for the daily counters (src/lib/ask/counters.ts).
//
// The page loads only the small opener below. The search, rendering and
// counter code arrives as a separate chunk the first time the panel opens.
import {
  CONTACT_LINKS,
  EXAMPLE_QUESTIONS,
  PANEL_NOTE,
  READING_LINKS,
} from "../../lib/ask/panel-copy";
---

<dialog class="ask-dialog" aria-labelledby="ask-title" data-ask-dialog>
  <div class="ask-shell">
    <header class="ask-head">
      <h2 id="ask-title" class="ask-title">Ask about my work</h2>
      <button class="ask-close" type="button" data-ask-close>close</button>
    </header>

    <div class="ask-scroll">
      <p class="ask-note">{PANEL_NOTE}</p>

      <form class="ask-form" data-ask-form>
        <label class="ask-label" for="ask-input">Your question</label>
        <div class="ask-field">
          <input
            id="ask-input"
            class="ask-input"
            type="search"
            name="q"
            maxlength="200"
            autocomplete="off"
            enterkeyhint="search"
            data-ask-input
          />
          <button class="ask-submit" type="submit">search</button>
        </div>
      </form>

      <section aria-labelledby="ask-examples-title">
        <h3 id="ask-examples-title" class="ask-sub">Try one of these</h3>
        <ul class="ask-examples">
          {
            EXAMPLE_QUESTIONS.map((q) => (
              <li>
                <button class="ask-example" type="button" data-ask-example={q}>
                  {q}
                </button>
              </li>
            ))
          }
        </ul>
      </section>

      <p class="ask-status" role="status" aria-live="polite" data-ask-status></p>

      <section aria-labelledby="ask-history-title" data-ask-history hidden>
        <div class="ask-history-head">
          <h3 id="ask-history-title" class="ask-sub">This session</h3>
          <button class="ask-clear" type="button" data-ask-clear>
            clear history
          </button>
        </div>
        <div class="ask-log" data-ask-log></div>
      </section>

      <footer class="ask-foot">
        <p class="ask-foot-line">
          Read:
          {
            READING_LINKS.map((l, i) => (
              <>
                {i > 0 && " · "}
                <a href={l.href}>{l.label}</a>
              </>
            ))
          }
        </p>
        <p class="ask-foot-line">
          Ask directly:
          {
            CONTACT_LINKS.map((l, i) => (
              <>
                {i > 0 && " · "}
                <a href={l.href}>{l.label}</a>
              </>
            ))
          }
        </p>
      </footer>
    </div>
  </div>
</dialog>

<script>
  // The only code on every page: reveal the trigger and open the panel. The
  // panel's own chunk is imported on the first open.
  const dialog = document.querySelector<HTMLDialogElement>(
    "[data-ask-dialog]",
  );
  const openers = document.querySelectorAll<HTMLElement>("[data-ask-open]");
  if (dialog && typeof dialog.showModal === "function") {
    let controller: Promise<typeof import("./controller")> | null = null;
    for (const opener of openers) {
      opener.hidden = false;
      opener.addEventListener("click", async () => {
        controller ??= import("./controller");
        try {
          const { openPanel } = await controller;
          openPanel(dialog);
        } catch {
          // Chunk failed to load (offline): the page keeps working without it.
          controller = null;
        }
      });
    }
  }
</script>

<style is:global>
  .ask-dialog {
    margin: 0 0 0 auto;
    padding: 0;
    width: min(480px, 100vw);
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    background: var(--paper);
    color: var(--ink);
    border: 0;
    border-left: 1px solid var(--rule);
    border-radius: var(--r-0);
  }
  .ask-dialog::backdrop {
    background: rgb(0 0 0 / 0.55);
  }
  .ask-shell {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .ask-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    padding: var(--s-4);
    border-bottom: 1px solid var(--rule);
  }
  .ask-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 18px;
    letter-spacing: -0.01em;
  }
  .ask-scroll {
    flex: 1;
    overflow-y: auto;
    padding: var(--s-4);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
  .ask-note,
  .ask-foot-line,
  .ask-status {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .ask-label,
  .ask-sub {
    display: block;
    margin: 0 0 var(--s-2);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .ask-field {
    display: flex;
    gap: var(--s-2);
  }
  .ask-input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    padding: 0 var(--s-3);
    font: inherit;
    font-size: 16px; /* 16px stops iOS zooming the page on focus */
    color: var(--ink);
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: var(--r-1);
  }
  .ask-input:focus-visible,
  .ask-submit:focus-visible,
  .ask-close:focus-visible,
  .ask-example:focus-visible,
  .ask-clear:focus-visible,
  .ask-dialog a:focus-visible,
  .ask-hit summary:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }
  .ask-submit,
  .ask-close,
  .ask-clear {
    min-height: 44px;
    padding: 0 var(--s-4);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: var(--r-0);
    cursor: pointer;
  }
  .ask-submit:hover,
  .ask-close:hover,
  .ask-clear:hover {
    border-color: var(--signal);
  }
  .ask-examples {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .ask-example {
    min-height: 44px;
    padding: var(--s-2) var(--s-3);
    font: inherit;
    font-size: 14px;
    text-align: left;
    color: var(--ink-soft);
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: var(--r-0);
    cursor: pointer;
  }
  .ask-example:hover {
    color: var(--ink);
    border-color: var(--signal);
  }
  .ask-history-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    margin-bottom: var(--s-3);
  }
  .ask-history-head .ask-sub {
    margin: 0;
  }
  .ask-log {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }
  .ask-entry {
    border-top: 1px solid var(--rule);
    padding-top: var(--s-3);
  }
  .ask-q {
    margin: 0 0 var(--s-3);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
  .ask-hits {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
  .ask-hit-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2);
    margin-bottom: var(--s-1);
  }
  .ask-kind {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .ask-hit-title {
    font-size: 15px;
    font-weight: 700;
  }
  .ask-excerpt,
  .ask-full {
    margin: 0 0 var(--s-2);
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink);
  }
  .ask-excerpt mark {
    background: transparent;
    color: var(--signal);
    font-weight: 700;
  }
  .ask-hit summary {
    cursor: pointer;
    font-size: 13px;
    color: var(--ink-soft);
    margin-bottom: var(--s-2);
  }
  .ask-full {
    white-space: pre-line;
    color: var(--ink-soft);
  }
  .ask-source {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-soft);
    overflow-wrap: anywhere;
  }
  .ask-dialog a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-underline-offset: 3px;
  }
  .ask-fallback {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
  }
  .ask-foot {
    margin-top: auto;
    padding-top: var(--s-3);
    border-top: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  @media (max-width: 680px) {
    .ask-dialog {
      margin: auto 0 0;
      width: 100vw;
      height: 90dvh;
      max-height: 90dvh;
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
  }
</style>
