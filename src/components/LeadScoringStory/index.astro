---
// LeadScoringStory: assembles the flagship case study at
// /work/call-tiers-lead-scoring. The prose is the entry's Markdoc body; this
// component splits it at its chapter headings and seats one Explorable figure
// in each chapter, between the setup and the finding.
//
// Everything here is server-rendered. The figures enhance themselves; with
// scripts off the page still reads start to finish with each figure in its
// resolved starting state. Figure data lives in ./data.ts, under the rule
// that every printed number is published on a source case study.

import ChapterRail from "../Explorable/ChapterRail.astro";
import CutoffDial from "../Explorable/CutoffDial.astro";
import Figure from "../Explorable/Figure.astro";
import PairingMatrix from "../Explorable/PairingMatrix.astro";
import RatioPair from "../Explorable/RatioPair.astro";
import ShareShift from "../Explorable/ShareShift.astro";
import { PostContent } from "../PostContent";
import {
  CHAPTERS,
  DECILE_HEIGHTS,
  DECILE_NOTES,
  decileReadout,
  EFFORT_SEGMENTS,
  EFFORT_STATES,
  FIGURE_AFTER,
  MATRIX_BUCKETS,
  MATRIX_CELLS,
  MATRIX_COLS,
  MATRIX_ROWS,
  RATE_RATIO,
  TIER_CUT_PERCENT,
} from "./data";
import { buildStoryParts } from "./segments";

interface Props {
  /** The entry's Markdoc body, as the Keystatic reader returns it. */
  document: unknown;
}

const { document } = Astro.props;
const parts = buildStoryParts(document, FIGURE_AFTER);
const chapterId = (i: number) => `chapter-${i + 1}`;
const rail = CHAPTERS.map((chapter, i) => ({
  ...chapter,
  href: `#${chapterId(i)}`,
}));
---

<PostContent document={parts.intro} />

<nav class="story-rail" aria-label="Chapters">
  <ChapterRail chapters={rail} label="Chapters" />
</nav>

<section class="story-chapter" id={chapterId(0)}>
  <PostContent document={parts.chapters[0].before} />
  <Figure
    id="figure-tier-matrix"
    label="figure 01 · tiers"
    title="Answer the two questions. See which tier the lead lands in."
    measured="Two lead-form questions, study timeframe and reason for enquiring, were combined into a matrix of every answer pairing to define three intent tiers."
    illustrative="The answer options, and the tier each pairing lands in. The real matrix was scored on historical lead-to-application conversion rates, which are not published."
  >
    <PairingMatrix
      id="tier-matrix"
      rows={MATRIX_ROWS}
      cols={MATRIX_COLS}
      buckets={MATRIX_BUCKETS}
      cells={MATRIX_CELLS}
      initial={[1, 1]}
      caption="Every pairing of the two answers, and the intent tier it lands in. Illustrative."
      legendLabel="intent tier"
    />
  </Figure>
  <PostContent document={parts.chapters[0].after} />
</section>

<section class="story-chapter" id={chapterId(1)}>
  <PostContent document={parts.chapters[1].before} />
  <Figure
    id="figure-call-effort"
    label="figure 02 · effort"
    title="Switch from before to after. Watch where the effort goes."
    measured="Share of weekly outbound call attempts landing on bottom-tier leads: 27.8% before calling stopped for that tier, 0.7% after. Top-tier leads applied at eight times the bottom tier's rate, on 30-day application rates for mature cohorts."
  >
    <ShareShift
      id="call-effort"
      measure="share of weekly call effort"
      switchLabel="calling policy"
      segments={EFFORT_SEGMENTS}
      states={EFFORT_STATES}
    />
    <RatioPair {...RATE_RATIO} />
  </Figure>
  <PostContent document={parts.chapters[1].after} />
</section>

<section class="story-chapter" id={chapterId(2)}>
  <PostContent document={parts.chapters[2].before} />
  <Figure
    id="figure-cutoff"
    label="figure 03 · cutoff"
    title="Drag the cutoff. See what three tiers can cut, and what ten deciles can."
    measured="The tiers reached roughly 27% of call effort cut. Around 600k leads were assembled to build the model. The move toward half is an expectation, not yet a result."
    illustrative="The height of every bar, and the even spread of call effort across deciles. The real curve comes from the model once it has run."
  >
    <CutoffDial
      id="decile-cutoff"
      heights={DECILE_HEIGHTS}
      illustrative
      coarseCutPercent={TIER_CUT_PERCENT}
      coarse={{ keep: "Tiers 1 and 2", cut: "Tier 3" }}
      initialKept={5}
      controlLabel="Cutoff: how many of the ten deciles get a call"
      axis={{ best: "most likely to apply", worst: "least likely" }}
      readout={decileReadout}
      notes={DECILE_NOTES}
      legend={{
        kept: "Called",
        band: "Only a score for each lead can cut this",
        cut: "Not called",
      }}
    />
  </Figure>
  <PostContent document={parts.chapters[2].after} />
</section>

<section class="story-closing">
  <PostContent document={parts.closing} />
</section>

<style>
  .story-rail {
    margin: var(--s-6) 0 0;
  }

  .story-chapter {
    scroll-margin-top: var(--s-8);
  }
</style>
